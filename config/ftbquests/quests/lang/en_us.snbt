{
	chapter.07790A767C847C57.title: "Cataclysm"
	chapter.0BA7C5B351EC2475.subtitle: "Secondary Aspects, Linking the World"
	chapter.0BA7C5B351EC2475.title: "Chapter 4"
	chapter.17482BD4DB583890.title: "Before the Beginning"
	chapter.18D6D677C375F38F.subtitle: "The Six Primary Aspects, Writing the World"
	chapter.18D6D677C375F38F.title: "Chapter 1"
	chapter.2005A8ABF505A870.title: "Nifty Gadgets"
	chapter.20392DD40E1EED8C.subtitle: "&kA stretch of garbled text&r"
	chapter.20392DD40E1EED8C.title: "Chapter 7"
	chapter.2E61D6C20298F803.subtitle: "Pairing and Combining, Reshaping the World"
	chapter.2E61D6C20298F803.title: "Chapter 5"
	chapter.2FC62A29C3E61A5E.title: "Eternal Starlight"
	chapter.35BD379C9EA94AEA.subtitle: "Blood Pact and Star Guidance, Weaving the World"
	chapter.35BD379C9EA94AEA.title: "Chapter 3"
	chapter.496B807D8BE0B3FE.title: "Twilight Forest"
	chapter.5196E500B38ADA0E.title: "Unknown Technology"
	chapter.569E4BE55E1C440F.title: "The Aether"
	chapter.572A55A700B05B5A.subtitle: "Meteor Engraving, Forging the World"
	chapter.572A55A700B05B5A.title: "Chapter 2"
	chapter.69D614063602F65E.title: "Dimensions, Aspects, and This World"
	chapter.7BE58E7C6030198B.title: "Resource Production"
	chapter.7FE4693A264FF39A.subtitle: "Even the Stars Are Not the End"
	chapter.7FE4693A264FF39A.title: "Chapter 6"
	chapter_group.3F4D8FC0357D0EBB.title: "Additional Chapters"
	chapter_group.5D4B0C6183F5C265.title: "Journeys of Exploration"
	chapter_group.76D01E7F0542ED7A.title: "Main Story"
	file.0000000000000001.title: "Essence Odyssey"
	quest.00402EA6B1870ECF.quest_desc: [
		"&aCopper and zinc&r become a Brass Ingot in the Alloy Kiln."
		""
		"Compared with Andesite Alloy, brass performs better: it can be made into more precise equipment and take on more complex crafting tasks."
	]
	quest.00402EA6B1870ECF.title: "The Brass Age"
	quest.0109DF2D0978C413.quest_desc: ["The Maledictus wields these weapons depending on the skill it uses — and now you can craft them &afor your own use&r."]
	quest.0109DF2D0978C413.title: "Cursium Weapons"
	quest.011DB0FFB4E95919.quest_desc: [
		"Jail of Cold generates in the frozen tundra of the &aOverworld&r — a castle guarded by Draugr."
		""
		"This is where the &aMaledictus&r is sealed away."
		""
		"This structure can be found with the &aEye of Curse&r."
	]
	quest.011DB0FFB4E95919.title: "Jail of Cold"
	quest.01673A6CBCB91BDE.quest_desc: [
		"&oThe rune altar writes the aspect down — not into a bottle, but into a rule you can carry and call upon.&r"
		""
		"Three materials and the Chaos Essence carve this one stroke: from now on, &#626262breaking down&r can be called up by ritual."
	]
	quest.0171C96CB85AC0B5.quest_desc: ["Forget those slow, plodding production lines — you can now &aupgrade&r your Mechanical Press, Mechanical Mixer, Deployer and Spout!"]
	quest.01789FF24DAB1731.quest_desc: [
		"&o&7When the first Steel Ingot came out of the furnace, you understood it all the more clearly: magic, technology and adventure were never three separate roads, but three ways of reading one and the same world. The way the six primordial aspects write the world has unfolded under your feet as well.&r"
		""
		"You have walked through six dimensions and brought their traces back one by one: crystals, essences, tokens; you have built rituals and devices, and production lines that turn on their own."
		"{@pagebreak}"
		"But &athe block at the center of the meteor&r is still lying there. You cannot break it, and you cannot read it."
		""
		"&lNext, it is time to learn to read it.&r"
	]
	quest.01789FF24DAB1731.title: "A New Beginning"
	quest.01E75843E7AA2555.quest_desc: ["Welcome to the world of Essence Odyssey!"]
	quest.01E75843E7AA2555.title: "Welcome"
	quest.0258FA1C2F0406EA.quest_desc: [
		"The Aether's aspect is &#FFFF7Eair&r. It &#FFFF7Echanges&r and &#FFFF7Espreads&r, and it means &#FFFF7Efreedom&r."
		""
		"Its response object here is the Golden Aercloud."
		""
		"Here, a Bottle and Cork collects Bottled Dawn."
	]
	quest.0258FA1C2F0406EA.title: "Visit the Aether"
	quest.02CA2F9CD0E2AE8A.quest_desc: [
		"&oYour fingers tingle strangely as you handle the amethyst shard. What does that mean?&r"
		""
		"&oYou notice a faint glow rising from the amethyst shard, as if it were pointing you somewhere.&r"
	]
	quest.02CA2F9CD0E2AE8A.title: "Strange \"Dreams\""
	quest.031C571BBFFCE0B6.quest_desc: [
		"The Nether's aspect is &#FF5A01fire&r. It &#FF5A01releases&r and &#FF5A01transforms&r, and leaves ash behind after the &#FF5A01burning&r."
		""
		"Its response object here is fire itself."
		""
		"Here, a Bottle and Cork collects Bottled Ghosts."
	]
	quest.031C571BBFFCE0B6.title: "Visit the Nether"
	quest.0447158FB18F70D5.quest_desc: [
		"The Inscriber Press can no longer come from the Mysterious Cube — &myou cannot even break the Mysterious Cube.&r"
		"The channel count in this modpack is twice the default."
	]
	quest.0447158FB18F70D5.title: "AE2 Notes"
	quest.04AE1E7E0CAA5837.quest_desc: ["&oDiamonds are not a requirement — most people just think they are.&r"]
	quest.04AE1E7E0CAA5837.title: "In Case You Can't Find Diamonds"
	quest.04C5D1E537383AFD.quest_desc: [
		"&oDrop the Chaos Crystal into the Imbuement Chamber — the source will soak through it first.&r"
		""
		"The Black Corundum Cluster on the pedestal holds back the environmental information, letting only the purest part settle."
		""
		"What remains is the Chaos Essence: it no longer remembers what it broke apart, only &#626262possibility not yet fixed&r."
	]
	quest.05491F312D2EDBAB.quest_desc: ["In Eternal Starlight, right-click a blooming Starlit Lily Pad or a similar block with an Amethyst Shard."]
	quest.074A2E5B400DF699.quest_desc: [
		"You begin with only six hearts. Do not worry too much, though: every 10 different foods you eat grant you 2 more hearts (five foods at first), and by eating a wide enough variety you can reach 40 hearts in total."
		"On top of that, Life Shards from the Aether dimension grant you 10 extra hearts."
	]
	quest.074A2E5B400DF699.title: "Max Health Notes"
	quest.08C5BA5D71D244AF.quest_desc: [
		"&oDrop the Fire Crystal into the Imbuement Chamber — the source will soak through it first.&r"
		""
		"The Red Corundum Cluster on the pedestal holds back the environmental information, letting only the purest part settle."
		""
		"What remains is the Fire Essence: it no longer remembers what it burned, only &#FF5A01releasing&r, &#FF5A01transforming&r, &#FF5A01burning&r."
	]
	quest.08C5BA5D71D244AF.title: "Fire Essence"
	quest.096875F870AB8F0B.title: "Industrial Squeezer"
	quest.09A2129D419DDC49.quest_desc: ["&o&mRiver power, easy as that!&r"]
	quest.09A2129D419DDC49.quest_subtitle: ["River Power"]
	quest.09A2129D419DDC49.title: "Stress Production (2)"
	quest.0AD91A5126496988.quest_desc: [
		"&o&7You still cannot say what these things in your hands are. You only followed the notebook and did it once.&r"
		""
		"&oYet they work. The notebook does not explain.&r"
	]
	quest.0B5E4ACB7E34CCC5.quest_desc: [
		"In most cases, aura-generating devices cannot push the amount of aura in an area past a certain value. The &aCreational Catalyst&r removes that limit with ease — you only need to place it under an &aaura-generating device&r."
		""
		"But to make one, you first have to &adrain&r most of the aura out of an area, enough to collect a Bottled Vacuum."
	]
	quest.0C176F5CCC18F301.quest_desc: ["Collected with a Bottle and Cork from the aura field of Eternal Starlight."]
	quest.0C963B7BCA20460B.quest_desc: [
		"&o&7The compass brings you to a crater.&r"
		""
		"&oThe crater is bigger than you expected. Nothing grows along its rim; the soil has burned black, and a ring of shapeless gravel and rubble spreads outward from it. At its very center lies a huge mass of sky stone — not any stone of this world, and harder than iron.&r"
		"{@pagebreak}"
		"&oA Mysterious Cube is set into the middle of it. In all that black, it alone is bright — impossibly bright: blue light flows across its surface, as if something inside has not stopped moving.&r"
		""
		"&oThe sky stone also wraps a number of crystals that give off a faint blue glow. They seem to still be growing, sprouting clusters of clear crystal.&r"
		"{@pagebreak}"
		"&o&7You cannot tell what this great mass and the things inside it are good for.&r"
	]
	quest.0C963B7BCA20460B.title: "Discover the Meteor"
	quest.0DB2CD482BA01F58.quest_desc: ["In the Overworld, drop an Amethyst Shard into a cauldron filled with water."]
	quest.0DE6FE73C42F8CA2.quest_desc: [
		"&oThe forest ritual recorded what life felt facing this dimension.&r"
		""
		"In the &#3EDCFFwater&r token is sorrow — it teaches life about flow and loss."
	]
	quest.0DF94450C70D2259.quest_desc: [
		"The Overworld's aspect is &#3EDCFFwater&r. It &#3EDCFFflows&r and &#3EDCFFholds&r, and &#3EDCFFcarries on&r all life."
		""
		"Its response object here is a cauldron filled with water."
		""
		"Here, a Bottle and Cork collects Bottled Sunlight."
	]
	quest.0DF94450C70D2259.title: "Visit the Overworld"
	quest.0FF0A4AD565E2758.quest_desc: [
		"&aEnder Golems&r sleep on the first and second floors of the Ruined Citadel, standing guard. The moment intruders appear, they wake and fight."
		""
		"Killing an Ender Golem yields a &aVoid Core&r."
		""
		"And do be careful of the &atraps&r all over the Ruined Citadel!"
	]
	quest.11F05068792402E5.quest_desc: [
		"&o&7You open the notebook.&r&r"
		""
		"&lYou found me.&r"
		""
		"You have probably noticed by now that the world has changed — let us call it &l\"The Change\"&r."
		""
		"Its cause is unknown, but its main effects are these:"
		"{@pagebreak}"
		"(1) The passages between the six isolated dimensions have been opened completely. Portals that could once exchange only items now &n&lallow living things to cross&r into the dimension on the other side."
		""
		"(2) Aspects that once sat quietly inside the aura field now &l&nspill over&r into the physical world in certain places. Aspects that have spilled over seem able to be &l&n&acarried&r by certain materials and condense into a &l&n&amaterial form&r."
		""
		"(3) The primary aspects have been observed to grow active; by different means, the corresponding &n&lderivatives&r can be obtained."
		""
		"(4) &kThe primary aspects no longer exist in isolation; they can combine two by two to yield a number of &l&nsecondary aspects&r."
		"&o&7There seems to be more, but for now you do not know what it means.&r"
	]
	quest.11F05068792402E5.quest_subtitle: ["The Change"]
	quest.1217950B47119C27.quest_desc: [
		"&6&oCataclysm (L_Ender's Cataclysm)&r&o is a mod that adds many difficult dungeons, challenging bosses and powerful equipment.&r"
		""
		"&oExplore its structures, defeat its bosses to prove yourself, and take their equipment to press on!&r"
		"{@pagebreak}"
		"&o&aNote: the eyes Cataclysm adds for locating structures are not consumed — a copy flies out of your hand when you use one. But an eye can only be used in the dimension of the structure it locates.&r"
		""
		"&o&aThe order in which the bosses are laid out in this chapter does not reflect their difficulty.&r"
	]
	quest.1217950B47119C27.title: "Before You Set Out"
	quest.1307B2956D04D7A2.quest_desc: [
		"The Deployer is more precise than a player's block-hands: it can carry out exact sequential assembly."
		""
		"With a Gold Sheet as the base and each component fitted in turn, you obtain a &aPrecision Mechanism&r."
		"{@pagebreak}"
		"Yet even something as precise as a Deployer can slip. Assembly &adoes not always succeed&r."
		""
		"Perhaps there will be a &abetter way&r to produce Precision Mechanisms later?"
	]
	quest.1307B2956D04D7A2.title: "Precision Mechanism"
	quest.140B027BBF9B47B2.quest_desc: [
		"&oThe forest ritual recorded what life felt facing this dimension.&r"
		""
		"In the &#626262chaos&r token is confusion — it takes away certainty and direction."
	]
	quest.1553D272E3538E31.quest_desc: [
		"The Knight Stronghold is a ruin in the Dark Forest, watched over by goblins in knight armour; deep inside stands a pedestal that once held a trophy."
		""
		"The &aKnight Phantom&r wanders behind the pedestal. Put it to rest, and the mechanisms of the &aDark Tower&r are yours to work."
	]
	quest.15A06B3385469BF5.quest_desc: [
		"&o&6The Maledictus — once a legendary warrior of the frozen land, later a tyrant commander, now a cursed undead.&r"
		""
		"Pass through the Door of Seal to enter its arena; right-click the &aCursed Tombstone&r to summon the Maledictus."
	]
	quest.15A06B3385469BF5.title: "Trial of the Maledictus"
	quest.163B8AE539C58E2B.quest_desc: ["So it is not a singularity after all..."]
	quest.163B8AE539C58E2B.title: "Well, It Works"
	quest.1655971899AF0256.quest_desc: [
		"Source is the driving force behind devices and rituals — much of your work depends on it."
		""
		"An Imbuement Chamber can still gather source from its surroundings by itself, but if you feed it source that is already at hand, its crafting becomes much faster."
		""
		"There are many different ways to obtain source — you can collect it with the various &aSourcelinks&r. Perhaps there are other methods?"
	]
	quest.1655971899AF0256.title: "Source Production"
	quest.177F832B5872D164.quest_desc: [
		"&o&7You retreat to a safe distance and light the fuse.&r"
		""
		"&oWhen the dust settles, there are no scattered remains on the ground — only a few items, perfectly intact.&r"
		""
		"&o&7You open the notebook again. It says:&r"
		"{@pagebreak}"
		"That is how you obtained the ME Drive and the ME Storage Cell."
		""
		"They &aare not things of this world&r; they can hold matter in something smaller than a chest."
		""
		"This pinch of powder seems &aable to do more than that&r."
	]
	quest.177F832B5872D164.title: "Starting Point"
	quest.18DEB55F4DEDB7A3.quest_desc: [
		"The world was never built by any single force alone."
		""
		"The six primary aspects write the six dimensions, each in its own posture, together making up the world beneath your feet."
		""
		"This expedition is not a conquest of some world, but a gathering of traces and a record of rules — and the first true connection between forces that were once sealed off from one another."
	]
	quest.18DEB55F4DEDB7A3.title: "The Beginning"
	quest.1A72CFCDBF3ABF73.title: "Bottling Machine"
	quest.1B4EBBF517C2C707.quest_desc: [
		"Fear takes root in the dark and grows into terror."
		""
		"&#56C000Earth&r makes life face the unknown — terror gives the unknown a border."
	]
	quest.1EA7CB9F4E022E6E.quest_desc: ["In the Nether, drop an Amethyst Shard into fire."]
	quest.203DC11C3D09AFA2.quest_desc: [
		"&o&6A machine left behind by an ancient civilisation, armed with missile launchers and a circular saw — a powerful guard at the heart of the Ancient Factory.&r"
		""
		"Make good use of the &aEMP&r in the Ancient Factory: give it a redstone signal to &aactivate&r it. Once active it can &astun&r The Harbinger and The Prowler within a certain range, and &akill&r nearby Watchers."
	]
	quest.203DC11C3D09AFA2.title: "Kill The Prowler"
	quest.217A0236C9312C68.quest_desc: [
		"The Twilight Forest's aspect is &#56C000earth&r. It &#56C000settles&r, draws &#56C000boundaries&r, and &#56C000grows&r upon them."
		""
		"Its response objects here are Liveroot, Cicada Jars and Firefly Jars."
		""
		"Here, a Bottle and Cork collects Bottled Twilight."
	]
	quest.217A0236C9312C68.title: "Visit the Twilight Forest"
	quest.22BBDE618BB134FE.title: "Industrial Fermenter"
	quest.236B9D3A654D936D.quest_desc: [
		"&aAn Alternator&r turns stress into electricity; an &aIridescent Pulsating Crystal&r turns &asource&r and &aaura&r into electricity."
		""
		"&aA Tesla Coil&r can spend that electricity to charge items."
		""
		"&oSo now you have electricity: a universal conversion node that unifies every kind of “energy”, and something you can feed into a grid and carry far away. It will get a chapter of its own later.&r"
	]
	quest.236B9D3A654D936D.title: "Power Generation and Use"
	quest.23801395A0C28C71.quest_desc: [
		"&oThe rune altar writes the aspect down — not into a bottle, but into a rule you can carry and call upon.&r"
		""
		"Three materials and the Fire Essence carve this one stroke: from now on, &#FF5A01burning&r itself can be called up by ritual."
	]
	quest.24015ACDFF37D790.quest_desc: ["Collected with a Bottle and Cork from the aura field of the Overworld."]
	quest.26C4569F0CA4E7D7.quest_desc: [
		"?! A Crushing Wheel crushing a Crushing Wheel?!"
		"Crush a Crushing Wheel with a Crushing Wheel — will the Crushing Wheel be crushed by the Crushing Wheel?"
	]
	quest.26C4569F0CA4E7D7.title: "Crushing Wheels"
	quest.27219131E0E42F88.quest_desc: ["Feeding a Baby Leviathan with a &aTropical Fish&r tames it; it will then fight for you with its unripe abyssal power."]
	quest.2740A375D6EBCB05.quest_desc: [
		"Immerse an aspect crystal in liquid source, and you will obtain &l&n&aaspect fluid&r."
		""
		"Once it has soaked a crystal, the source loses its colour and rises as a wisp of pale smoke, gone into the air."
	]
	quest.2740A375D6EBCB05.title: "Aspect Fluid Buckets"
	quest.27F647FAFC46B251.quest_desc: [
		"The &aAbyssal Sacrifice&r is used to summon the Leviathan."
		""
		"Every material for it except the Heart of the Sea can be found in Sunken in the Sea; a &aBuried Treasure Map&r in its treasure room can help you obtain a Heart of the Sea."
	]
	quest.2A0D63839EC06CB6.quest_desc: [
		"&o&7Last night the dream came again: three different aspect crystals, redstone, crushed together with flint, and kept in a bowl.&r"
		""
		"&o&7When I woke up I tried to reproduce the recipe, and so I got a pinch of faintly glowing powder.&r"
		""
		"Salis Mundus — Thaumaturge's Salt, as it is more commonly known — is not any one aspect; it is their reconciler: like salt in the mundane world, it has no taste of its own, yet it lets the most distant aspects share the same thing."
	]
	quest.2A0D63839EC06CB6.title: "Salis Mundus"
	quest.2A90934B95C717BC.quest_desc: [
		"A forest ritual uses the properties of gold to imbue a living, growing sapling with the strength of its ingredients. The materials you offer \"describe\" to the sapling the rule you wish to reproduce or transform, and Gold Powder uses that still-growing life to write the description back into reality."
		""
		"To perform a forest ritual you need Gold Powder. Your first batch comes from a &afalling Anvil&r striking Gold Leaf. You will also need Wooden Stands, obtained by right-clicking a stripped Oak Log with Brilliant Fiber on a &aCutting Board&r."
	]
	quest.2A90934B95C717BC.title: "Ritual of the Forest"
	quest.2CC22C2203005BFF.title: "Refinery"
	quest.2D72B8B451B12DFB.quest_desc: [
		"The &aImbuement Chamber&r injects source into an item in order to craft it."
		""
		"During the process, if there are items on the pedestals around the Imbuement Chamber, their information is injected along with it."
	]
	quest.2D72B8B451B12DFB.title: "Imbuement Chamber"
	quest.2D9A7BCB69358AFC.quest_desc: [
		"&o&6The Netherite Monstrosity guards a forge much as its \"relative\" the Redstone Monstrosity (from Minecraft Dungeons) does — and though this forge is far smaller than the Blazing Forge, the beast is no less mighty.&r"
		""
		"Walk to the centre of the &aplatform the Monstrosity rests on&r, and it will wake from its sleep."
	]
	quest.2D9A7BCB69358AFC.title: "Trial of the Netherite Monstrosity"
	quest.2E5D92132F9FA3DC.quest_desc: [
		"&oWith the &aNatural Altar&r&o and a &aTesla Coil&r&o, you smelt your first Steel Ingot. From this ingot on, machine parts can truly be called precision work.&r"
		""
		"&o&mHonestly, I have no idea how I came up with a recipe this arcane either&r"
	]
	quest.2E5D92132F9FA3DC.title: "Steel Ingot"
	quest.2EC65ED47EDA8740.quest_desc: ["The Lightning Spear it fires pierces Ignis's shield and deals damage."]
	quest.2F4141AE42BB5E86.quest_desc: [
		"The Soul Forge was raised in the &aNether&r by the piglins, to build terrible machines of war."
		""
		"A dreadful &aNetherite Monstrosity&r sleeps inside it."
		""
		"This structure can be found with the &aEye of Monstrous&r."
	]
	quest.2F4141AE42BB5E86.title: "The Soul Forge"
	quest.2F80A4788FDBB0B5.quest_desc: [
		"This is an advanced workstation; it &afuses&r equipment and materials together into stronger gear."
		""
		"Unlike an anvil, it &adoes not fall&r when there is nothing under it, and using it &adoes not damage it or cost experience&r."
	]
	quest.30B6340921229929.quest_desc: [
		"&o&7The amethyst leads you to &r&o&aa cauldron full of water&r&o&7.&r"
		""
		"The amethyst has revealed to you the &#3EDCFFwater&r hidden in the Overworld's aura field. You received its answer, and an &l&n&aaspect crystal&r condensed."
		""
		"Once it has condensed, the light on the amethyst surface fades; all that is left is a film of grey, which crumbles to powder at a touch."
	]
	quest.30B6340921229929.title: "Water Crystal"
	quest.31208139567F93AE.quest_desc: [
		"No tool you have can break the mysterious block in the meteorite — no pick pries it loose, no explosion leaves a mark."
		""
		"&7&oThe notebook mentioned a &a&lmixture of unclear composition&r&7&o, and maybe it is worth a try? What would happen if you sprinkled it onto the mysterious block?&r"
	]
	quest.31208139567F93AE.title: "Mysterious Cube"
	quest.3122552A78D4DDA5.quest_desc: [
		"The Ancient Factory lies deep under the &aOverworld&r; no one has come here for many years."
		""
		"In its core rests &aThe Harbinger&r, a creation of the ancient civilisation."
		""
		"This structure can be found with the &aEye of Mech&r."
	]
	quest.3122552A78D4DDA5.title: "Ancient Factory"
	quest.34164812034BC9A0.quest_desc: [
		"&o&6The Ender Guardian lurks in the deepest part of the Ruined Citadel, punishing intruders with the power of Ender and Void.&r"
		""
		"Approach the &aAltar of Void&r at the centre of the Citadel's third floor and the Ender Guardian will spawn."
		""
		"&o&mDoes the Ender Guardian not get enough respect? One gauntlet is all it drops? And I have to dig my own way into the boss room???&r"
	]
	quest.34164812034BC9A0.title: "Trial of the Ender Guardian"
	quest.34172736AC658A51.quest_desc: ["Upgrade your matching &aNetherite armor&r with a &aSmithing Template (Cursium Upgrade)&r and a Cursium Ingot at a smithing table."]
	quest.34172736AC658A51.title: "Cursium Set"
	quest.3453F3AF03FF04C4.quest_desc: [
		"&o&6\"So far, no matter how close.\"&r",
		"",
		"&oAfter you solder the components onto the mainboard one by one, you find that it has changed shape.&r",
		"",
		"&oIt looks no different from the Mysterious Cube, the blue light still flowing across its surface — but this time you can read it, &alike a finished poem&r&o.&r"
	]
	quest.348FD640D0B99AE2.quest_desc: [
		"&o&6A senior guard of the acropolis — a giant crayfish with a great axe, and strength without equal.&r"
		""
		"&o&mBoth the weakest and the strongest mini-boss are in the acropolis, as it happens.&r"
	]
	quest.348FD640D0B99AE2.title: "Kill the Clawdian"
	quest.3582A8AFBE363D4B.quest_desc: [
		"The Cauldron is the first container this world gave you. Sprinkle in a handful of &asalis mundus&r, and it becomes a container that can hold anything."
		""
		"The Mechanical Mixer turns mixing from an action into a process; its &arotation speed&r decides how fast it goes."
		""
		"A Blaze Burner is indispensable as well — some things will only accept one another in enough &aheat&r."
	]
	quest.3582A8AFBE363D4B.title: "Mixing"
	quest.35CE21DCABAAF10A.quest_desc: [
		"&o&6The Harbinger — a mechanical wither built by the ancients, with devastating power.&r"
		""
		"Hold a &aNether Star&r and right-click the sleeping Harbinger in the Ancient Factory to wake it."
	]
	quest.35CE21DCABAAF10A.title: "Trial of The Harbinger"
	quest.3676A11CC0AC3510.quest_desc: [
		"The inside of Desert Pyramid Revamped is a maze holding countless treasures. But as you explore, beware the skeletal jackal-headed guards and the traps that are everywhere."
		""
		"Brushing the &aSuspicious Sand&r inside the pyramid may yield the Necklace of the Desert, which can wake the Ancient Remnant."
	]
	quest.368C96B399AD1368.quest_desc: [
		"&oThe rune altar writes the aspect down — not into a bottle, but into a rule you can carry and call upon.&r"
		""
		"Three materials and the Order Essence carve this one stroke: from now on, &#D8D7F0binding&r and &#D8D7F0repeating&r can be called up by ritual."
	]
	quest.37F411FC6258C723.quest_desc: ["&oNow you can see what lies on the other side of the glowstone gate.&r"]
	quest.37F411FC6258C723.title: "In Case You Can't Find Glowstone"
	quest.380E92E17E92D38B.quest_desc: ["&o&mTake as much stress as you like (?).&r"]
	quest.380E92E17E92D38B.quest_subtitle: ["The Steam Age"]
	quest.380E92E17E92D38B.title: "Stress Production (3)"
	quest.3811626F7A0570C2.quest_desc: [
		"&oDrop the Earth Crystal into the Imbuement Chamber — the source will soak through it first.&r"
		""
		"The Green Corundum Cluster on the pedestal holds back the environmental information, letting only the purest part settle."
		""
		"What remains is the Earth Essence: it no longer remembers which rings of wood it pressed, only &#56C000settling&r, &#56C000bounding&r, &#56C000growing&r."
	]
	quest.3811626F7A0570C2.title: "Earth Essence"
	quest.382FD077B4CB5BA6.quest_desc: ["&oThat shouldn't work... right?&r"]
	quest.382FD077B4CB5BA6.title: "In Case You Can't Beat a Blaze and an Enderman"
	quest.38F89B3C95DB51AC.quest_desc: ["In the Aether, drop an Amethyst Shard into the Golden Aercloud."]
	quest.397C219C667CE90A.quest_desc: ["Collected with a Bottle and Cork from the aura field of the Aether."]
	quest.3ADEEEDFEED6AFAA.quest_desc: [
		"&o&7You try to pry the Mysterious Cube out of the sky stone, and find that nothing you have can break it. You decide to look at the notebook again.&r"
		""
		"&oOne of the loose pages tucked inside carries a line of small writing:&r"
		"{@pagebreak}"
		"&aThe outer shell of the sky stone&r and the &acertus quartz&r wrapped inside it seem to give this world a special response. Grind each of them into dust, then mix them with &asalis mundus&r in a Basin, add &alava&r, and &apress them into shape&r. What you get is a kind of &l&aunknown powder&r."
		""
		"&oDo as it says for now, and see what comes out."
	]
	quest.3ADEEEDFEED6AFAA.title: "Revelation of the Fallen Star"
	quest.3B39350B3C6A7D55.quest_desc: [
		"&oThe rune altar writes the aspect down — not into a bottle, but into a rule you can carry and call upon.&r"
		""
		"Three materials and the Earth Essence carve this one stroke: from now on, &#56C000settling&r and &#56C000growing&r can be called up by ritual."
	]
	quest.3BBB6BA364026473.quest_desc: ["There seems to be a &a&lhidden room&r in the Soul Forge. Go and look?"]
	quest.3E2DFA7DE032E3E8.quest_desc: [
		"The Burning Arena stands in the &aNether&r. It has been abandoned for years, but the fire inside it has never gone out."
		""
		"It is where &aIgnis&r makes its home."
		""
		"This structure can be found with the &aEye of Flame&r."
	]
	quest.3E2DFA7DE032E3E8.title: "Burning Arena"
	quest.3F64EB93903B0250.quest_desc: [
		"Corundum can be found underground in large patches, and usually generates as two colors together. It can be &aconverted&r into other colors in an Imbuement Chamber."
		""
		"When placed low underground, corundum slowly grows upward (not all that slowly, actually?) and comes with a few corundum clusters."
	]
	quest.3F64EB93903B0250.title: "Corundum"
	quest.3F8681ECC0F4EC99.quest_desc: ["The Burning Arena is guarded by &aIgnited Revenants&r. Kill one of them and you will earn the right to wake Ignis — a &aBurning Ashes&r."]
	quest.400F9EA8BED6E390.quest_desc: [
		"Windmill Sails are made with Tough Fabric."
		""
		"&o&mOr you could just stack up a lump of wool, if you like.&r"
	]
	quest.400F9EA8BED6E390.quest_subtitle: ["Windmill"]
	quest.400F9EA8BED6E390.title: "Stress Production (1)"
	quest.40A0FF3C16F17A99.quest_desc: [
		"&oThe forest ritual recorded what life felt facing this dimension.&r"
		""
		"In the &#56C000earth&r token is fear — it makes life face the dark and the unknown."
	]
	quest.424A36FF905942D5.quest_desc: [
		"The amethyst has revealed the &#3EDCFFwater&r held in the Overworld's aura field, and you have received its response."
		""
		"Next, try collecting aura from the Overworld with a &aBottle and Cork&r, and see what happens."
	]
	quest.424A36FF905942D5.title: "Bottled Sunlight"
	quest.431A6B56EE43ADEE.quest_desc: [
		"You have collected aura from the Overworld, together with the &l&nenvironmental information&r and &l&naspect information&r it carries."
		""
		"Now continue the expedition: set foot in the other dimensions, and answer the calls that come from them."
		""
		"&oNote: the quest line of this chapter revolves around the &#3EDCFFwater&r&o of the Overworld only. Another chapter, &l\"Dimensions, Aspects, and This World\"&r&o, collects the related content of every primary aspect.&r"
	]
	quest.431A6B56EE43ADEE.title: "The Six Primary Aspects"
	quest.4363AE8363EC43A6.quest_desc: [
		"Some recipes can only be made on a &aMechanical Crafter&r; a crafting table cannot handle them."
		""
		"&oEspecially the small gadgets: some of them need a Mechanical Crafter. Check this card's follow-up quests to see which.&r"
	]
	quest.4363AE8363EC43A6.title: "Mechanical Crafter"
	quest.460FC1911724CF88.quest_desc: ["&oTo be honest, it really is just a fancy pickaxe — but it &ais really cool&r&o, is it not?&r"]
	quest.46B818618F767629.quest_desc: [
		"The Ashen Sapling is an excellent carrier of aura, and an important tree for performing forest rituals of every kind."
		""
		"Ashen Saplings can be &adug up by a Sniffer&r, or &amade with a forest ritual&r."
	]
	quest.46B818618F767629.title: "Ashen Sapling"
	quest.4732C23C21EA0CCE.quest_desc: [
		"&oDrop the Air Crystal into the Imbuement Chamber — the source will soak through it first.&r"
		""
		"The Yellow Corundum Cluster on the pedestal holds back the environmental information, letting only the purest part settle."
		""
		"What remains is the Air Essence: it no longer remembers which cloud it crossed, only &#FFFF7Echanging&r, &#FFFF7Espreading&r, &#FFFF7Estaying free&r."
	]
	quest.476E0AEAFEDFA031.quest_desc: [
		"Joy rising high becomes euphoria."
		""
		"&#FFFF7EAir&r lets life feel light — euphoria is light enough to forget that it still has to land."
	]
	quest.477C7D68B338367C.quest_desc: [
		"Andesite Alloy is made from andesite and an Iron Ingot or a Zinc Ingot on a &aCutting Board&r. It is lighter than iron, yet it carries rotation steadily."
		""
		"&o&7You put together your first Andesite Alloy.&r"
		""
		"&o&mBut why a cutting board?!&r"
	]
	quest.477C7D68B338367C.title: "Andesite Alloy"
	quest.481ECA1B87829938.title: "Crude Blast Furnace"
	quest.48407C982D11D8DC.quest_desc: [
		"Corundum is an excellent magical material: it can absorb environmental information."
		""
		"Place corundum on a pedestal and use source as the driving force. The environmental information in the items around it is caught by the corundum, and the environmental information inside aspect crystals is absorbed as well; only the &l&npure aspect information&r is left. The crystal is soaked through, taken apart, and rearranged — what condenses out is &amagical essence&r."
	]
	quest.48407C982D11D8DC.title: "Essence"
	quest.485146C723E79D3B.quest_desc: [
		"The Deployer is a perfect copy of your own block-hands: it can &aimitate the interactions you perform&r."
		""
		"Set it a program, and it will repeat it over and over."
	]
	quest.485146C723E79D3B.title: "Deployer"
	quest.4882FCF67676C010.quest_desc: [
		"&o&6Ignis — lord of flame, god of war exalted.&r"
		""
		"Right-click the &aAltar of Fire&r at the centre of the Burning Arena's top floor with a &aBurning Ashes&r to summon Ignis."
	]
	quest.4882FCF67676C010.title: "Trial of Ignis"
	quest.4A540375BBDC6D05.quest_desc: [
		"To obtain casings of every kind, you first need to grow &aAshen Trees&r."
		""
		"A casing's frame cannot be just any block of wood: it has to hold its shape inside aura for a long time, and only the Ashen Tree can do that."
	]
	quest.4A540375BBDC6D05.title: "Andesite Casing"
	quest.4B699022B1FD8A00.quest_desc: [
		"It seems you have noticed something strange about the amethyst shard."
		""
		"Under the influence of The Change, amethyst shards can catch aspects that have spilled out of the aura field."
		""
		"Follow where the shard leads and seek out a &l&nresponse object&r&r. Let the amethyst touch an aspect that has spilled over, and you may well get what you are after."
	]
	quest.4BB8027A2703FC28.quest_desc: ["&o&mAnd here I thought, in proper Cataclysm fashion, this anchor would turn out to be a pickaxe?&r"]
	quest.4D69672AA9A6CB0D.quest_desc: [
		"Sunken in the Sea rises from the deep &aOverworld&r ocean — an ancient ruin of masterful craft."
		""
		"Here, an old ritual can summon the &aLeviathan&r."
		""
		"This structure can be found with the &aEye of Abyss&r."
	]
	quest.4D69672AA9A6CB0D.title: "Sunken in the Sea"
	quest.4E8041B1FBD6669F.quest_desc: [
		"The End's aspect is &#626262chaos&r. It &#626262breaks down&r what exists, pushes everything into the &#626262unknown&r, and leaves behind only &#626262possibilities not yet fixed&r."
		""
		"Its response object here is the End portal."
		""
		"Here, a Bottle and Cork collects Bottled Darkness."
	]
	quest.4E8041B1FBD6669F.title: "Visit the End"
	quest.4F1594D45E71BD67.quest_desc: ["The aspect information and environmental information held in the materials are imbued into an Ashen Sapling together. The forest ritual records the emotion that life leaves behind when it faces the world, and gives it form as a wooden statue — a &atoken&r."]
	quest.4F1594D45E71BD67.title: "Tokens"
	quest.505D9FE85D283F43.quest_desc: [
		"The Acropolis generates in the warm ocean biomes of the &aOverworld&r — a grand complex of buildings."
		""
		"It is the holy ground where &aScylla&r, queen of the storm, dwells with her followers."
		""
		"This structure can be found with the &aEye of Storm&r."
	]
	quest.505D9FE85D283F43.title: "The Acropolis"
	quest.516C33B1C8134654.quest_desc: [
		"&o&6Scylla — the name of a female sea monster in ancient Greek legend; and the thing you face atop the acropolis, stirring the storm, may well be the queen of the storm itself — also Scylla.&r"
		""
		"Climb to the top of the acropolis and you reach the building where the boss waits. When you are ready, &aright-click the anchor at its very centre&r to call Scylla and begin the fight."
	]
	quest.516C33B1C8134654.title: "Trial of Scylla"
	quest.54946257C2AB9DCF.quest_desc: [
		"To make use of aspect crystals, you need to prepare a few things first."
		""
		"Gold is an excellent conductor: it can guide the flow of aspects, and in a forest ritual it serves as the medium between people and nature. Your first step is to turn it into Brilliant Fiber and put that to use."
		""
		"Your first Brilliant Fiber comes from holding a Gold Ingot in your main hand and String in your off hand, then right-clicking a &ahedge&r in the Twilight Forest. The drop rate is rather low, and the thorns will &ahurt you&r."
	]
	quest.54946257C2AB9DCF.title: "Brilliant Fiber"
	quest.54CC0D96675F33E8.quest_desc: [
		"To establish a connection with this world, you first need to gather &aAmethyst Shards&r."
		""
		"Perhaps a Dowsing Rod would help you find an amethyst geode."
	]
	quest.54CC0D96675F33E8.title: "Amethyst Shard"
	quest.5538B917632BBC54.quest_desc: ["Collected with a Bottle and Cork from the aura field of the Twilight Forest."]
	quest.56952889BA57C65D.quest_desc: [
		"&o&6The Ancient Remnant — a giant spinosaurus skeleton, sleeping in the deepest part of the cursed pyramid, waiting for a challenger.&r"
		""
		"Hang the &aNecklace of the Desert&r around the Ancient Remnant's neck to wake it."
	]
	quest.56952889BA57C65D.title: "Trial of the Ancient Remnant"
	quest.5781F26291987E67.quest_desc: [
		"&oThe forest ritual recorded what life felt facing this dimension.&r"
		""
		"In the &#D8D7F0order&r token is serenity — it settles life into structure and constancy."
	]
	quest.57E4DA3C7780AAAD.quest_desc: ["The Alloy Kiln melts two materials together to make certain &aalloys&r."]
	quest.57E4DA3C7780AAAD.title: "Alloy Kiln"
	quest.57F8ADC74552877F.quest_desc: [
		"&oThe rune altar writes the aspect down — not into a bottle, but into a rule you can carry and call upon.&r"
		""
		"Three materials and the Air Essence carve this one stroke: from now on, &#FFFF7Espreading&r and &#FFFF7Estaying free&r can be called up by ritual."
	]
	quest.5860A88B6FA1AC51.quest_desc: [
		"&oThe rune altar writes the aspect down — not into a bottle, but into a rule you can carry and call upon.&r"
		""
		"Three materials and the Water Essence carve this one stroke: from now on, &#3EDCFFflowing&r itself can be called up by ritual."
	]
	quest.5971AA7E8234AA79.title: "Pressure Chamber"
	quest.4F8FD0BAF765BFF8.title: "Meteor Components"
	quest.4F8FD0BAF765BFF8.quest_desc: [
		"&oThe blueprint continues:&r",
		"",
		"Once you have the mainboard, five components must be soldered onto it, one after another.",
		"",
		"&oTheir recipes are recorded in JEI — go and take a look.&r"
	]

	quest.5AA560228973D274.quest_desc: [
		"Calculation, engineering, logic, silicon — four Inscriber Presses. They can be used to make every kind of processor.",
		"",
		"&oThe fallen star never gave you revelation, nor handed you a method of manufacture: it left only &aa meteor&r&o, &aa blueprint&r&o, and &aa path you walked yourself&r&o.&r",
		"",
		"&oThe notebook explains no more, but the unknown technology has already opened before you. From here on, the road is yours to explore.&r"
	]
	quest.5AA560228973D274.title: "Reshaping Applied Energistics"
	quest.5E4647B964AD82A1.quest_desc: [
		"&aThe Natural Altar&r is crafted in the Enchanting Apparatus from six kinds of tokens — life's six responses to the world."
		""
		"It gathers the aura of a stretch of land and imbues it into items. The power of nature will no longer be confined to one patch of ground, but will become the root that runs through all realms and gives rise to every living thing."
	]
	quest.5E4647B964AD82A1.title: "Natural Altar"
	quest.5E6A08A57900AFE8.quest_desc: [
		"&oDrop the Water Crystal into the Imbuement Chamber — the source will soak through it first.&r"
		""
		"The Blue Corundum Cluster on the pedestal holds back the environmental information, letting only the purest part settle."
		""
		"What remains is the Water Essence: it no longer remembers which cauldron it came from, only &#3EDCFFflowing&r, &#3EDCFFholding&r, &#3EDCFFcarrying on&r."
	]
	quest.5FC00933683D6F6B.quest_desc: [
		"&oThe forest ritual recorded what life felt facing this dimension.&r"
		""
		"In the &#FFFF7Eair&r token is joy — it lets life feel light and unbound."
	]
	quest.60362BA2A41B4033.quest_desc: [
		"&oBefore we begin, let us take a look at the world you live in.&r"
		""
		"&oThis world is made of six great dimensions. Each of the six is rich in one &l&nprimary aspect&r&o — the &#3EDCFFwater&r&o running through the Overworld, the &#FF5A01fire&r&o burning in the Nether, the &#56C000earth&r&o sleeping beneath the Twilight Forest, the &#FFFF7Eair&r&o echoing across the Aether, the &#626262chaos&r&o unordered in the End, and the &#D8D7F0order&r&o constant in Eternal Starlight.&r"
		"{@pagebreak}"
		"&oThese aspects &l&nhave no physical form&r&o; they are carried by &l&naura&r&o. They quietly fill the &l&naura field&r&o of their own dimension, and remain stable there.&r"
		""
		"&oDimensions do not connect with or affect one another. Portals between them do exist, but that connection is far too unstable — it can barely carry items through.&r"
		""
		"&oThe six primary aspects write the six dimensions, each in its own posture, reaching through heaven and earth and making up every part of this world.&r"
	]
	quest.6133B55F3B880EC1.quest_desc: ["Inside the Quartz Temple stands a mysterious &aAltar of Amethyst&r. It turns Amethyst Crab Meat into Blessed Amethyst Crab Meat, which will help you in the fight against the Leviathan."]
	quest.6256F04D11B48E39.quest_desc: [
		"The Mechanical Press presses metal ingots into &asheets&r."
		""
		"Sheets are the intermediate form of many machine parts."
		""
		"Note that it cannot handle &aSteel Ingots&r; you will need another way."
	]
	quest.6256F04D11B48E39.title: "Mechanical Press"
	quest.636F2AFB3BF2AC31.quest_desc: [
		"&aThe Enchanting Apparatus&r is crafted from six kinds of essence in a forest ritual."
		""
		"It combines the materials on the pedestals with the item at its center — a bridge that connects all things: magic and technology, source and aura, living things and the world."
		""
		"&o&mIt is basically a forest ritual with more particle effects (?)&r&r"
	]
	quest.636F2AFB3BF2AC31.title: "Enchanting Apparatus"
	quest.64DDBFEA863697E9.title: "Metal Press"
	quest.656B7D59A1F6492F.quest_desc: ["&oThat is impossible.&r"]
	quest.656B7D59A1F6492F.title: "In Case You Don't Know What the Overworld Is"
	quest.6576FFF207EECE9E.quest_desc: [
		"&o&6A senior guard of the acropolis — a seahorse with a trident, a fine warrior with strong close-quarters skill and ability.&r"
		""
		"&o&mThis is honestly the mini-boss that feels the most like a common mob in Cataclysm.&r"
	]
	quest.6576FFF207EECE9E.title: "Kill the Hippocamtus"
	quest.6916611959D6968A.quest_desc: [
		"A Modern Remnant can be summoned with a &aRemnant's Skull&r and tamed with a &aSniffer Egg&r."
		""
		"Once tamed, it will attack whatever you attack, or whatever is attacking you."
	]
	quest.6951B60D890910D1.quest_desc: [
		"Aura in the aura field does not come back on its own once it has been drawn out."
		""
		"But do not worry — this is not a problem. You can produce aura in &aseveral different ways&r."
		""
		"The one thing to keep in mind is this: by default, there is a &alimit&r to how much aura a single area can hold."
	]
	quest.6951B60D890910D1.title: "Aura Generation"
	quest.6BA679217AD6DBB8.title: "Coke Oven"
	quest.6BD5C4A261AF78A6.quest_desc: [
		"&oThe forest ritual recorded what life felt facing this dimension.&r"
		""
		"In the &#FF5A01fire&r token is anger — it teaches life to release and to flare."
	]
	quest.6CDE0F370C954563.quest_desc: ["Right-click leaves with Brilliant Fiber to turn them into &aGolden Leaves&r. Golden Leaves spread to the leaves around them; harvest them after a while and you will have Gold Leaf in quantity."]
	quest.6CDE0F370C954563.title: "Gold Leaf"
	quest.6D0337DB8C14104E.quest_desc: [
		"This is just an ordinary blocky world, and you are an ordinary person in it."
		""
		"You thought life would go on as ordinary as ever — until, from some day you cannot pin down, the world quietly became different."
		""
		"You cannot say how it is different, but you found a notebook titled \"Essence Odyssey\" — the quest book in your hands."
		"{@pagebreak}"
		"&oNote: from here on, &rtext in regular type&o marks what the notebook records, while italic text is narration. &aGreen text&r&o usually marks hints and guidance, and &7pale gray text&r&o usually describes what the player did or what happened in the story.&r"
		""
		"&oWhen a piece of this modpack's worldbuilding appears for the first time, it is marked in &l&nbold and underlined&r&o, or with &l\"…\"&r&o.&r"
		""
		"&oGear-shaped quests are key nodes; rounded-square quests are optional or hidden quests.&r"
	]
	quest.6D0337DB8C14104E.title: "Introduction"
	quest.6D1E3B2DB0CF6EB6.quest_desc: [
		"Eternal Starlight's aspect is &#D8D7F0order&r. It emphasizes &#D8D7F0structure&r, &#D8D7F0repetition&r, and &#D8D7F0constancy&r."
		""
		"Its response objects here are blooming Starlit Lily Pads and seeded Blocks of Thioquartz."
		""
		"Here, a Bottle and Cork collects Bottled Starlight."
	]
	quest.6D1E3B2DB0CF6EB6.title: "Visit Eternal Starlight"
	quest.6DDF94B179429870.quest_desc: [
		"&o— Only the weak need this.&r"
		"&o— Yes, I am the weak one.&r"
	]
	quest.6DDF94B179429870.title: "In Case You Can't Find Obsidian"
	quest.6DE914EC13E3D516.quest_desc: [
		"&6&oThe Abyss gazes into you.&r"
		""
		"Once you have slain the Leviathan, &aCoral Golems&r, &aDeepling Priests&r and &aDeepling Warlocks&r begin to spawn rarely in any ocean biome."
	]
	quest.6E879124E9249E36.quest_desc: [
		"The Rolling Mill rolls metal further into &arods&r and &awires&r."
		""
		"Note that it cannot handle &aSteel Ingots&r either."
	]
	quest.6E879124E9249E36.title: "Rolling Mill"
	quest.6EC80EDEED6DBEE5.quest_desc: [
		"One step past confusion lies delirium."
		""
		"&#626262Chaos&r takes away direction — in delirium, even the question \"where am I going?\" is gone."
	]
	quest.704148E137D62A82.quest_desc: [
		"&o&7After you work it loose with that pinch of powder, you finally see the patterns flowing across its surface, and the flickering light — like lines of characters left unfinished.&r",
		"",
		"&oThe notebook leaves a machining blueprint:&r",
		"",
		"Send the whole block into the assembly line: fit &acapacitors&r, &afluix crystals&r and &acontrol chips&r, then cut and press. What comes out is a few mainboards."
	]
	quest.72207EFC62718B7D.title: "Refinery"
	quest.724CFEFED2FB7209.quest_desc: [
		"&oDrop the Order Crystal into the Imbuement Chamber — the source will soak through it first.&r"
		""
		"The White Corundum Cluster on the pedestal holds back the environmental information, letting only the purest part settle."
		""
		"What remains is the Order Essence: it no longer remembers what it arranged, only &#D8D7F0structure&r and &#D8D7F0repetition&r."
	]
	quest.724CFEFED2FB7209.title: "Order Essence"
	quest.72B021AA3E3944F3.quest_desc: ["Ancient Leaves hold a rich store of aura, &areleasing it slowly&r to top up the aura field around them whenever its concentration drops."]
	quest.72B021AA3E3944F3.title: "Ancient Sapling"
	quest.746F388E40C7B518.quest_desc: [
		"Desert Pyramid Revamped stands in the wide deserts of the &aOverworld&r — a relic of an ancient civilisation."
		""
		"The &aAncient Remnant&r sleeps here."
		""
		"This structure can be found with the &aEye of Desert&r."
	]
	quest.746F388E40C7B518.title: "Desert Pyramid Revamped"
	quest.747DC66590F1BF6C.quest_desc: [
		"&o&6The Leviathan — master of the abyssal power, a dreadful predator that can tear even time and space apart.&r"
		""
		"At the bottom of the water in the centre of Sunken in the Sea, right-click the &aAltar of Abyss&r with an &aAbyssal Sacrifice&r to summon the Leviathan."
	]
	quest.747DC66590F1BF6C.title: "Trial of the Leviathan"
	quest.75A85A3EB42EA77D.quest_desc: ["Collected with a Bottle and Cork from the aura field of the Nether."]
	quest.75CBBA83CDDDFB00.quest_desc: ["Collected with a Bottle and Cork from the aura field of the End."]
	quest.75FB247B07C3BF7B.title: "Crusher"
	quest.77CCF6E3CA3E9F38.quest_desc: ["&o...Fine, have it your way.&r"]
	quest.77CCF6E3CA3E9F38.title: "In Case You Can't Beat the Gatekeeper or the Ender Dragon"
	quest.780012BD80D8EF84.quest_desc: [
		"&o&6You have slain every boss of Cataclysm, and stood upon its peak.&r"
		""
		"&oIf you happen to lose this record somewhere along the expedition, it does not matter — you can always come back here. The road is still long; if you are tired, stop for a while and rest.&r"
	]
	quest.780012BD80D8EF84.title: "Peak of Cataclysm"
	quest.78F4FA00C33D561F.quest_desc: [
		"The Ruined Citadel generates on the outer islands of the &aEnd&r."
		""
		"This is the maze-fortress of the &aEnder Guardian&r."
		""
		"This structure can be found with the &aEye of Void&r."
	]
	quest.78F4FA00C33D561F.title: "Ruined Citadel"
	quest.796BB04761A96F35.title: "Arc Furnace"
	quest.7BF679E3CD97A80C.quest_desc: [
		"Sorrow settling down becomes grief."
		""
		"&#3EDCFFWater&r teaches life about loss — grief teaches it that after losing, it still has to &#3EDCFFflow on&r."
	]
	quest.7BF7847A3ED73423.quest_desc: [
		"&o&7Following what the notebook describes, you tip several things into the Basin. When it cools, you are holding something you cannot put a name to.&r"
		""
		"&oIt is neither ore nor a finished product, and it gives off a faint yellow shimmer. The notebook does not say what it is; it only says what to do next:&r"
		""
		"Throw it in with a diamond chest, and set off an &l&aexplosion&r. Then come the blocks of raw iron and raw copper."
	]
	quest.7BF7847A3ED73423.title: "Unknown Mixture"
	quest.7C42E5E0147F4013.quest_desc: [
		"When anger burns out, rage is what remains."
		""
		"&#FF5A01Fire&r teaches life to flare — rage is not that single spark, but a will that keeps on burning."
	]
	quest.7C97F7759738AEA5.quest_desc: [
		"On this expedition, technology, magic and adventure were never three separate roads."
		""
		"Explore the world, and gather the traces the six great dimensions left behind;"
		"Use magic to turn those traces into materials you can work with;"
		"Develop technology, and build production lines that turn out every kind of material at scale."
	]
	quest.7CA4F20BED9F78F7.quest_desc: [
		"A meteor once crossed this night sky. Out there, at the edge of the world, something fell."
		""
		"It is not a thing of this world. It was hot as it fell, and moments later it was harder than anything around it. Its outer layer burned black."
		""
		"&l&aGo and find one.&r"
		""
		"&oSince it does not belong here, perhaps something can point out where it landed.&r"
	]
	quest.7D30D0CD5F0F151E.quest_desc: [
		"&oYou do not know why it all changed, but you want to know why.&r"
		""
		"&oFollowing the notebook's guidance, you set out on an expedition called &l\"Seeking the Origin of This World\"&r&o.&r"
		""
		"&oAnd so the story begins here.&r"
	]
	quest.7D30D0CD5F0F151E.quest_subtitle: "The Expedition"
	quest.7D30D0CD5F0F151E.title: "Seeking the Origin of This World"
	quest.7D4F28E1F908597D.quest_desc: ["The &aStrange Key&r drops from an &aAptrgangr&r. Hold it and right-click the &aDoor of Seal&r to break the seal; after a short animation, the gate opens."]
	quest.7F2312EB5A2653DB.quest_desc: ["In the Twilight Forest, right-click the Liveroot or a similar block with an Amethyst Shard."]
	quest.7F56175670CB6E0A.quest_desc: ["Drop an Amethyst Shard into the End portal."]
	quest.7F834AEA20EF6E4F.quest_desc: [
		"Serenity settling into the cycle becomes equanimity."
		""
		"&#D8D7F0Order&r settles life into structure — equanimity needs no reason, and no way out."
	]
	quest.7FAF4ACD7D385BEC.quest_desc: [
		"&6&oWithin the Nether Fortresses, Ignited Berserkers have awakened...&r"
		""
		"Once you have defeated Ignis for the first time, &aIgnited Berserkers&r begin to spawn in Nether fortresses. Killing one yields a &aDying Ember&r, which can be crafted into a &aBurning Ashes&r to summon Ignis again."
	]
