	task.52F7FD6FA9E4B929.title: "Claim a Music Disc"
	task.53413AAB9034897F.title: "Sorry, I never used this one — I fear nothing."
	task.5BFC72D203F93BB1.title: "Sorry, I never fought it — I skipped that lesson."
