	chapter_group.76D01E7F0542ED7A.title: "主线任务"
	file.0000000000000001.title: "本源远征"
	quest.00402EA6B1870ECF.quest_desc: [
		"&a铜和锌&r在合金窑里化作黄铜锭。"
		""
		"黄铜与安山合金相比具有更加优异的性能，能够合成更为精密的设备，承担更加复杂的合成任务。"
	]
	quest.00402EA6B1870ECF.title: "黄铜时代"
	quest.00D52A4B60E3BCAB.quest_desc: [
		"为&a榧木&r去皮后有概率获得&a粗绯夜脂&r。它有很多功能：可以作为燃料使用，也可用于给某些物品打蜡。"
		""
		"将粗绯夜脂与&a深板岩&r合成，可以获得&a绯夜脂锭&r。"
	]
	quest.00FB0980BFB14CD3.quest_desc: [
		"发酵桶可用于将菜籽油发酵为&a精制菜籽油&r。"
		""
		"将晶化油菜种子丢入精制菜籽油可以获得&a晶化油&r，将充能油菜种子丢入晶化油可以获得&a充能油&r。这两条配方也可以由&a热气动加工机&r或者&a搅拌机&r完成。"
	]
	quest.0109DF2D0978C413.quest_desc: ["咒翼灵骸会随所用技能换持这些武器；如今，你也能把它们做出来，&a为你自己所用&r。"]
	quest.0109DF2D0978C413.title: "咒魂武器"
	quest.011DB0FFB4E95919.quest_desc: [
		"苦寒监牢生成于&a主世界&r寒冷的冻原中，是一座被魂尸把守的城堡。"
		""
		"这里是&a咒翼灵骸&r的封印之处。"
		""
		"这个结构可以使用&a诅咒之眼&r寻找。"
	]
	quest.011DB0FFB4E95919.title: "苦寒监牢"
	quest.01673A6CBCB91BDE.quest_desc: [
		"&o符文祭坛把要素“写”了下来——不是装进瓶子，而是变成一条可以携带、可以调用的规则。&r"
		""
		"用三样材料与混沌之精华在祭坛上刻下这一笔：从此，&#626262崩解&r可以被仪式唤起。"
	]
	quest.0171C96CB85AC0B5.quest_desc: ["忘掉那些慢慢悠悠的产线吧，现在你可以&a升级&r你的各种机器！"]
	quest.01789FF24DAB1731.quest_desc: [
		"&o&7当第一块钢锭出炉时，你更加深刻地明白了：魔法、科技与冒险从来不是三条分开的路，而是理解同一个世界的三种方法。六重元始要素书写世界的方式，也已在你脚下展开。&r"
		""
		"你走过了六个维度，把它们的痕迹一件件带了回来：结晶、精华、印记；你还造出了各类仪式和装置，还有一条条能自己转起来的产线。"
		"{@pagebreak}"
		"但&a陨石中心那个方块&r还躺在那里，你破坏不了它，读不懂它。"
		""
		"&l接下来，是学会读懂它。&r"
	]
	quest.01789FF24DAB1731.title: "新的起点"
	quest.01E75843E7AA2555.quest_desc: ["欢迎来到本源远征的世界！"]
	quest.01E75843E7AA2555.title: "欢迎"
	quest.020283940C1ECF6D.quest_desc: ["在星光维度中使用&a星引火箭&r，可以唤来一场流星雨。"]
	quest.0258FA1C2F0406EA.quest_desc: [
		"天境的要素是&#FFFF7E风&r。它&#FFFF7E变化&r、&#FFFF7E传播&r，也意味着&#FFFF7E自由&r。"
		""
		"这里的回应物是金黄境云。"
		""
		"在这里，用瓶与塞可以收集到瓶装曙光。"
	]
	quest.0258FA1C2F0406EA.title: "天境"
	quest.0285D9D3BFC5CBEA.title: "电力与热量"
	quest.02B0BF4F271034FE.quest_desc: [
		"The meteor structure answers outside energy with a faint response, but the answer is far too brief to record. An amplifier driven by magical source can widen that echo, until a signal hidden deep inside the blocks becomes discernible for the first time."
		"What you need is not a stronger spell, but a precise enough way of listening."
	]
	quest.02CA2F9CD0E2AE8A.quest_desc: [
		"&o手捧紫水晶碎片的你，指尖忽然感受到一阵刺痛。或许有什么特殊含义？&r"
		""
		"&o你发现紫水晶碎片上冒出幽幽的光芒，似是在指引着某个方向。&r"
	]
	quest.02CA2F9CD0E2AE8A.title: "异“梦”"
	quest.031C571BBFFCE0B6.quest_desc: [
		"下界的要素是&#FF5A01火&r。它&#FF5A01释放&r、&#FF5A01转化&r，也在&#FF5A01燃烧&r之后留下灰烬。"
		""
		"这里的回应物是火焰本身。"
		""
		"在这里，用瓶与塞可以收集到瓶装鬼魂。"
	]
	quest.031C571BBFFCE0B6.title: "下界"
	quest.0447158FB18F70D5.quest_desc: [
		"现在压印模板无法来源于神秘方块，&m你甚至不能破坏神秘方块&r。"
		"整合包中的频道数是默认的两倍。"
	]
	quest.0447158FB18F70D5.title: "AE2说明"
	quest.04AE1E7E0CAA5837.quest_desc: ["&o钻石不是必需品，只是大多数人以为它是。&r"]
	quest.04AE1E7E0CAA5837.title: "以防你挖不到钻石"
	quest.04C5D1E537383AFD.quest_desc: [
		"&o把混沌结晶放进灌注室，魔源会先把它浸透。&r"
		""
		"基座上的黑色刚玉簇截留住其中的环境信息，只让最纯净的部分沉下来。"
		""
		"于是你得到混沌之精华：它不再记得自己崩解过什么，只记得&#626262尚未固定的可能&r。"
	]
	quest.05491F312D2EDBAB.quest_desc: ["在星光维度中，用紫水晶碎片右键盛开的星照睡莲等方块获取。"]
	quest.0728FFAFE3DF93E2.quest_desc: [
		"&o&6被月藤束缚在诅咒花园中的囚犯灵魂，在死亡后被同化为月藤广袤根系的一部分。&r"
		""
		"&o&6如今，它们仍然成群结队地在迷宫中游荡，拖着它们由植物形成的新躯体，随时准备用带毒的利爪撕碎入侵者。&r"
		""
		"&a藤骸&r会大量生成于诅咒花园中，击败它可以获得&a灵魂露珠&r。"
	]
	quest.0734386F2C539298.quest_desc: [
		"The six primary aspects are not naturally compatible. Each comes from a different dimension, carrying an environment and a set of rules that contradict the others. Calibration Gel soothes that conflict for a while, letting them hold a brief, stable resonance inside one structure."
		"It is not a fuel. It is the precondition that makes a single act of deciphering possible."
	]
	quest.074A2E5B400DF699.quest_desc: [
		"你初始只有六颗红心。但不要太担心，每吃10种不同的食物你都将获得2颗红心（一开始是五种），通过吃多种不同的食物你最多可以拥有40颗红心。"
		"另外，使用天境维度的生命补片可以使你额外获得10颗红心。"
	]
	quest.074A2E5B400DF699.title: "生命上限说明"
	quest.08C5BA5D71D244AF.quest_desc: [
		"&o把火之结晶放进灌注室，魔源会先把它浸透。&r"
		""
		"基座上的红色刚玉簇截留住其中的环境信息，只让最纯净的部分沉下来。"
		""
		"于是你得到火之精华：它不再记得自己烧过什么，只记得&#FF5A01释放&r、&#FF5A01转化&r、&#FF5A01燃烧&r。"
	]
	quest.08C5BA5D71D244AF.title: "火之精华"
	quest.094F8DB5315BE376.title: "电力与生命源质"
	quest.096875F870AB8F0B.title: "工业挤压机"
	quest.09A2129D419DDC49.quest_desc: ["&o&m河电，轻而易举啊！&r"]
	quest.09A2129D419DDC49.quest_subtitle: "河动力"
	quest.09A2129D419DDC49.title: "应力生产（其二）"
	quest.0A2D3B4F6D9CCB87.quest_desc: ["&o本章着重介绍整合包中主要的电力生产方式，以及电力与其他“能源”之间如何转化。"]
	quest.0A739937D1D185C7.quest_desc: [
		"传送门遗迹是在&a主世界&r生成的结构。"
		""
		"它在不同群系中生成时具有对应的变体，但无论哪种变体，其中都会包含一个守门人与一个雕纹虚空石框架。"
		""
		"&a&l去找一个吧&r，它会为你揭示一个&a被星光照亮的维度&r。"
	]
	quest.0A77FB1F1C2DB56B.quest_desc: [
		"使用&a电梯&r至少需要两个电梯方块，且多个电梯方块必须垂直放置，传送有效距离无限制，不同层之间的距离可以不相等。多个电梯方块中间隔着其他方块也可以正常传送。"
		""
		"站在电梯方块上，按&a跳跃键&r上升一层，按&a潜行键&r下降一层。"
		""
		"空手右击电梯方块可以打开设置界面。"
		"{@pagebreak}"
		"&o&m其实气动工艺模组和机械动力模组都有自己的搭建电梯的方式，但是哪能有这个来着方便（）&r"
	]
	quest.0A77FB1F1C2DB56B.title: "电梯"
	quest.0AD91A5126496988.quest_desc: [
		"&o&7你还是说不清手里这几样东西是什么。你只是照着笔记做了一遍。&r"
		""
		"&o可它们就是能用。笔记没有解释。&r"
	]
	quest.0B5E4ACB7E34CCC5.quest_desc: [
		"大多数情况下，灵气制造设备都无法让一片区域内的灵气量超过某个值。但&a制造催化剂&r可以轻易地移除这条限制，只要把它放在&a灵气制造设备下方&r就行了。"
		""
		"但要想制作出它，你需要先&a抽干&r一片区域里的大部分灵气，以收集一瓶真空。"
	]
	quest.0C176F5CCC18F301.quest_desc: ["用瓶与塞从星光维度的灵气场里收集来的。"]
	quest.0C5E798F28A231C4.quest_desc: [
		"冷冻器利用&a冰石&r冷冻物品。"
		""
		"在冷冻器下方放置&a冰石&r可以加速冷冻的过程，当然你也可以使用鼓风机批量冷冻。"
	]
	quest.0C6551855677E394.quest_desc: [
		"滑行魔石只能被&a镐子&r伤害。"
		""
		"当你将它唤醒后，它会锁定你，并使用&a滑动冲撞&r的方式进行攻击。它会以较快的速度沿方块排列的直线行进，尝试接近你，并击碎所有挡在它滑动路线上的方块。"
		""
		"当生命值降到100点（四分之一）时，滑行魔石会进入&a暴走状态&r，其石眼及顶部纹路会变为红色，滑动速度将会显著加快。"
	]
	quest.0C963B7BCA20460B.quest_desc: [
		"&o&7罗盘把你带到一个坑前。&r"
		""
		"&o坑比你想的大。边缘寸草不生，土烧成了黑色，往外散着一圈看不出形状的砂砾和碎石。坑的正中心有一块巨大的陨石——它不是这个世界的任何一种石头，比铁还坚硬。&r"
		"{@pagebreak}"
		"&o陨石的正中镶嵌着一个神秘方块。在一片黑里只有它是亮的，而且亮得不像话：蓝色的光芒在表面流淌，像有什么东西还没停下。&r"
		""
		"&o陨石里还包藏着一些水晶，发出幽幽的蓝光。它似乎还在生长，旁生出许多晶莹剔透的水晶簇。&r"
		"{@pagebreak}"
		"&o&7你看不出这一块巨大的陨石和它里面的东西对你有什么用。&r"
	]
	quest.0C963B7BCA20460B.title: "发现陨石"
	quest.0CE9557BA608CA22.title: "高级压缩机"
	quest.0DB2CD482BA01F58.quest_desc: ["在主世界中，将紫水晶碎片丢进装有水的炼药锅中。"]
	quest.0DE6FE73C42F8CA2.quest_desc: [
		"&o森林仪式记下了生命面对这个维度时留下的情绪。&r"
		""
		"&#3EDCFF水&r之印记里是忧伤——让生命懂得流动与失去。"
	]
	quest.0DF52CD073E9984C.quest_desc: ["&l你找到了我。&r"]
	quest.0DF94450C70D2259.quest_desc: [
		"主世界的要素是&#3EDCFF水&r。它&#3EDCFF流动&r、&#3EDCFF容纳&r，同时&#3EDCFF延续&r着一切生命。"
		""
		"这里的回应物是装满水的炼药锅。"
		""
		"在这里，用瓶与塞可以收集到瓶装阳光。"
	]
	quest.0DF94450C70D2259.title: "主世界"
	quest.0DFAA76C3EF9F0C3.quest_desc: [
		"在天境中，非天境维度的工具和武器将被&a削弱&r。"
		""
		"但与此同时，不同质地的天境工具各有一些其独特的功能与特性。"
	]
	quest.0E1DB2F236A70179.title: "电力与压力"
	quest.0EAD190E24BC4DAD.quest_desc: [
		"&a搅拌机&r用于将固体溶解于流体中，将它们混合在一起。"
		""
		"其能制作的东西，包括了……&a巧克力&r？"
	]
	quest.0EAD190E24BC4DAD.title: "搅拌机"
	quest.0F98658FB39A828A.quest_desc: ["狂瞳龙卷苏醒后会在中央露庭上空沿波浪状轨迹飞行。当其任意身体部件被摧毁后，会&a分裂&r为独立个体并自主攻击；龙首被摧毁时，后续龙身短暂僵直后将成为新龙首。"]
	quest.0FF0A4AD565E2758.quest_desc: [
		"&a末影傀儡&r作为废弃堡垒的守卫者，沉睡在它的第一层和第二层。一旦入侵者出现，它们便会苏醒并与之战斗。"
		""
		"击杀末影傀儡后可以获得&a虚空核心&r。"
		""
		"千万要小心废弃堡垒中随处可见的&a陷阱&r！"
	]
	quest.11F05068792402E5.quest_desc: [
		"&o&7你翻开了这本笔记。&r&r"
		""
		"&l你找到了我。&r"
		""
		"也许你已经注意到了，世界发生了变化——我们姑且称之为&l「异变」&r。"
		""
		"异变的原因不得而知，但它造成的影响主要有这些："
		"{@pagebreak}"
		"（1）六个孤立的维度间的通路被彻底打通，以前只能交换物品的传送门，现在&n&l允许生物穿越&r到另一边的维度。"
		""
		"（2）以前只会安静待在灵气场里的要素，现在在某些地方&l&n外溢&r到物质世界。它们似乎可以与某些物质&l&n共振&r，并凝结为&n&l物质形态&r。"
		""
		"（3）观察到元始要素变得活泼，通过不同的手段，可以得到相应的&n&l衍生物&r。"
		""
		"（4）&k元始要素间不再孤立存在，而是可以两两化合，得到若干&l&n二级要素&r。"
		"&o&7似乎还有些内容，但你现在不知道是什么含义。&r"
	]
	quest.1217093AA675C1E8.quest_desc: ["&a纠缠方块&r可以“吸收”被纠缠方块的各种能力，对这个方块的各种操作，如漏斗输入物品，相当于对被纠缠方块的操作。"]
	quest.1217950B47119C27.quest_desc: [
		"&6&o灾变（L_Ender's Cataclysm）&r&o是一个增加了多种不同的困难的地牢、各种具有挑战性的Boss和强大装备的模组。&r"
		""
		"&o探索多种结构，挑战并击败Boss以证明自己，获得强大的装备并继续向前进吧！&r"
		"{@pagebreak}"
		"&o&a注意：灾变添加的用于定位结构的眼睛不是消耗品，使用时会从你手中复制一份飞出，但眼睛只能在其定位的结构所在的维度使用。&r"
		""
		"&o&a本章中各boss的排布顺序并不代表各boss的难度。&r"
	]
	quest.1217950B47119C27.title: "启程前的提示"
	quest.1307B2956D04D7A2.quest_desc: [
		"机械手与玩家的方块手相比更加精密，能够进行精确的序列装配。"
		""
		"以金板为基底，依次安装各个组件，便能够得到&a精密构件&r。"
		"{@pagebreak}"
		"然而即便精确如机械手，也有失手的时候。组装&a并非必定成功&r。"
		""
		"或许以后会有&a更好的方法&r生产精密构件？"
	]
	quest.1307B2956D04D7A2.title: "精密构件"
	quest.133BB67CC60B260F.quest_desc: [
		"神能晶片类似天境中的&a煤炭&r，它可以用作&a神能炉&r的燃料。"
		""
		"除此之外，神能晶片还可以&a食用&r。&o&m(But why?)&r"
	]
	quest.13CF62C60D16A9DB.quest_desc: [
		"用&a风铃&r来装饰你的基地：将铃声带到你的世界！"
		""
		"当风铃被放置时，&a幻翼&r不会靠近你。"
		""
		"空手潜行右击风铃可以将其捆上，从而达到静音、关闭粒子效果的作用。（当然，不再能驱赶幻翼。）"
		"{@pagebreak}"
		"&a&l竹风铃&r将产生竹叶粒子效果；"
		""
		"&a&l刻制竹风铃&r由斧子右击竹风铃获得，它的声音更加低沉，并且不会产生竹子落叶的粒子效果；"
		"{@pagebreak}"
		"&a&l铁风铃&r会发出清脆的金属铃声；"
		""
		"&a&l铜风铃&r有着比铁风铃更为低沉的金属铃声；"
		"{@pagebreak}"
		"&a&l紫水晶风铃&r会发出紫水晶声音，它不能被捆上；"
		""
		"&a&l玻璃风铃&r可以在工作台中使用染料自定义颜色，其下方会悬挂短册，它也无法捆绑。"
	]
	quest.13CF62C60D16A9DB.title: "风铃"
	quest.13DA290A6AFCB1C4.quest_desc: [
		"&o&7九只奖杯被摆上附魔装置，暮色圣杯从光里浮出来，这是暮色森林给征服者的回礼。&r "
		""
		"&a暮色圣杯&r是合成&a暮色锭&r的催化剂，本身不会在合成中消耗。"
	]
	quest.13F6206C8B723102.quest_desc: [
		"压缩机是通过压缩空气来产生压力的机器。"
		""
		"压力P可以按如下公式计算：&l&aP = ( A / V ) - 1&r，其中A表示机器内存储的空气的量，V表示机器的容积。"
		""
		"这本手册可以教会你更多。"
	]
	quest.13F6206C8B723102.title: "基础压缩机"
	quest.140B027BBF9B47B2.quest_desc: [
		"&o森林仪式记下了生命面对这个维度时留下的情绪。&r"
		""
		"&#626262混沌&r之印记里是茫然——让生命失去确定与方向。"
	]
	quest.1529F9460D2A49FE.quest_desc: [
		"杂酚油可以用来制作&a防腐木板&r，一种非常结实的木板。"
		""
		"&a工程师装配台&r的合成材料中包含了防腐木板。它可用于组装&a工程师蓝图&r中记载的物品，也可用于&a改装与配置&r一些工具。"
	]
	quest.1553D272E3538E31.quest_desc: [
		"黑松骑士要塞是黑暗森林里的一片废墟，穿骑士盔甲的哥布林守在外面，废墟深处有一座放奖杯的基座。"
		""
		"&a幻影骑士&r在基座后徘徊；让它安息，你才能操纵&a黑暗高塔&r里的砷铅铁机关。"
	]
	quest.15A06B3385469BF5.quest_desc: [
		"&o&6咒翼灵骸，苦寒之地昔日的传奇战士，后来的暴虐统领，今日的诅咒亡灵。&r"
		""
		"通过封印之门后即可进入咒翼灵骸的战斗场地，右击&a被诅咒的墓碑&r即可召唤咒翼灵骸。"
	]
	quest.15A06B3385469BF5.title: "咒翼灵骸的试炼"
	quest.15B512E612FBC9BC.quest_desc: ["&a无伤&r击败狂瞳龙卷获得。"]
	quest.163B8AE539C58E2B.quest_desc: ["居然不是奇点么……"]
	quest.163B8AE539C58E2B.title: "还真行"
	quest.1655971899AF0256.quest_desc: [
		"魔源是驱动设备与仪式的推动力，许多工作都需要依靠它进行。"
		""
		"灌注室尚可从环境中直接积蓄魔源，但若是给它直接供应现成的魔源，合成会变得更快。"
		""
		"魔源有多种不同的获取方式，你可以通过各类&a魔源通道&r收集魔源。或许还有其他方法？"
	]
	quest.1655971899AF0256.title: "魔源生产"
	quest.177F832B5872D164.quest_desc: [
		"&o&7你退到安全的地方，点着了引线。&r"
		""
		"&o尘埃散去后，地上并没有散落的残骸，只有几样完好无损的物品。&r"
		""
		"&o&7你再次翻开笔记，其中写道：&r"
		"{@pagebreak}"
		"这样就获得了ME驱动器和ME存储元件。"
		""
		"它们&a不像这个世界的造物&r，能把物质存进比箱子还小的东西里。"
		""
		"这撮粉末似乎&a不只能做到这些&r。"
	]
	quest.177F832B5872D164.title: "起点"
	quest.186D50D15BDE751E.quest_desc: [
		"将&a星火&r向暮光沙（或沙子、红沙）投掷后，被命中的方块会转化为粗流璃。"
		""
		"粗流璃烧制以后可以获得&a流璃&r。"
		""
		"即使不使用带有精准采集附魔的工具破坏流璃，它也能以物品形式正常掉落；它也可以将永冻石装备升级成更强的流璃装备，需要&a锻造模板（流璃升级）&r。"
	]
	quest.18DEB55F4DEDB7A3.quest_desc: [
		"世界并非由某一种力量独自构成。"
		""
		"&a六重元始要素&r以不同姿态书写&a六个维度&r，共同构成你我所处的世界。"
		""
		"这场远征不是征服某个世界，而是收集痕迹、记录规律，并让原本彼此隔绝的力量第一次真正联结。"
	]
	quest.18DEB55F4DEDB7A3.title: "开端"
	quest.18FC77AF14B862AE.quest_desc: ["阿肯钢类似天境中的铁，需要&a紫晶等级&r的镐才能挖掘。"]
	quest.19047323B0DB5C28.quest_desc: ["烧炼来自于青铜地牢的&a海皇套装&r获得。"]
	quest.19B7F9090EBCABF9.quest_desc: ["使用&a动力合成器&r制作。"]
	quest.1A2BE9B2D68901FA.quest_desc: ["使用&a附魔装置&r制作。"]
	quest.1A64E09306C5EC80.quest_desc: [
		"&a牛头人迷宫&r藏在暮光沼泽的湿地之下，牛头人们在黑暗里守着一条通往火焰沼泽的路。 "
		""
		"迷宫深处的&a米诺菇&r守着它的蘑菇与沙拉酱，那酱肉能让身体适应&a火焰沼泽&r的高温。"
	]
	quest.1A72CFCDBF3ABF73.title: "灌装机"
	quest.1B2329D67EC21B7B.quest_desc: [
		"黄铜地牢是由雨云石与流光雨云石砌成的云端城堡，上下两层回廊环抱着中央露庭，风在廊柱间穿行。"
		""
		"露庭上空，盘踞着被囚于此的风暴之眼，黄铜钥匙的保管者——&a狂瞳龙卷&r。"
	]
	quest.1B4A781639CD6512.quest_desc: [
		"&a建筑棒&r可以一次放置多个方块。有五个不同的等级：木头、铜、铁、钻石和下界合金。每一个等级都提供了更多的耐久、更强的方块放置能力。"
		""
		"在按键绑定中可以为&a&l「打开建筑棒设置界面」&r绑定一个键位，以实现对建筑棒更多功能的调整。"
	]
	quest.1B4A781639CD6512.title: "建筑棒"
	quest.1B4EBBF517C2C707.quest_desc: [
		"恐惧在幽暗里扎下根，长成惊骇。"
		""
		"&#56C000地&r让生命面对未知——而惊骇给未知划出边界。"
	]
	quest.1C2C86D965817F76.quest_desc: [
		"&o&6作为这个古老而神秘的组织的一员，我们虽然身份各异，但都承担着这一古老而神圣的职责，即守卫星光维度的大门，确保只有勇敢而强大的人才能进入。&r"
		""
		"守门人守卫着星光维度的大门。"
		""
		"右键守门人便可与他对话，点击挑战即可与他战斗。"
		"{@pagebreak}"
		"若你成功击败守门人，他便会掉落&a战利品袋&r，其中包含用于开启星光维度传送门的&a先知球体&r，以及该维度的指南书&a漠光石板&r；"
		""
		"若你在与守门人战斗前已经击败过&a末影龙&r，那么无需战斗他便会直接给予你一个战利品袋。"
		"{@pagebreak}"
		"[ { \"text\": \"什么？你说守门人和末影龙你都打不过？！那看看\", \"italic\": true }, { \"text\": \"这张任务卡\", \"italic\": true, \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"77CCF6E3CA3E9F38\" } }, { \"text\": \"吧。\", \"italic\": true } ]"
	]
	quest.1C3D5A1A97167411.quest_desc: [
		"晶生催化器是一种半自动的超大范围&a方块采集&r器。"
		""
		"它以&a星辉水晶碎片&r为燃料，并且填充燃料后需要接受红石信号才能运作。"
		"{@pagebreak}"
		"启动后，晶生催化器会自动选取并破坏以自身为中心、周围一定范围内离自身最近的自然方块（泥土、石头、矿石等，优先破坏矿石），留下&a晶藓块&r或&a晶砂&r补位。"
	]
	quest.1EA7CB9F4E022E6E.quest_desc: ["在下界中，将紫水晶碎片丢入火焰中。"]
	quest.1ECEECDD3F1DBB34.quest_desc: ["主要用于为水晶赋能。"]
	quest.1F294AEF1621DA65.quest_desc: [
		"&a旅行锚&r允许你传送至其他旅行锚。它可以被&a喷涂机&r喷涂&o&m（虽然貌似有点奇妙的渲染问题）&r，右击以打开配置界面，可以配置显示的图标与名称。"
		""
		"站在旅行锚上时，附近一定范围内的旅行锚会被&a高亮显示&r，右击或按下潜行键/跳跃键即可传送；手持&a旅行权杖&r时，无需站在其上也可以高亮显示附近的旅行锚。"
		""
		"旅行锚也可以如电梯一般垂直放置使用。"
	]
	quest.1F37C07E86AB1EAC.quest_desc: ["&a无伤&r击败烈阳巨灵获得。"]
	quest.1FBA99E5D96BD893.quest_desc: ["An ordinary circuit can carry energy, but it cannot preserve the traces left behind by aura, source and resonating aspects. The Arcane Wafer combines the stability of minerals, the activity of nature and the perception of magic into a medium capable of recording anomalous signals."]
	quest.203DC11C3D09AFA2.quest_desc: [
		"&o&6远古文明留下的机械造物，拥有导弹发射器和圆形电锯，是古代工厂中心的强力守卫。&r"
		""
		"善用古代工厂中的&a电磁脉冲装置&r，给它施加红石信号来&a激活&r。它激活后能&a眩晕&r一定范围内的先驱者和徘徊者，并&a击杀&r附近的观测者。"
	]
	quest.203DC11C3D09AFA2.title: "击杀徘徊者"
	quest.216FDC1A803B60AC.quest_desc: [
		"&o&7笔记翻到这一页，字迹比别处潦草。&r"
		""
		"红石酸的威力比想象中还要强，我尝试着把这些毫不相干的金属溶在一起，再撒上那撮&l&a未知的粉末&r。等冷却下来以后，它们变成了一种&a特殊的合金&r。"
		""
		"&o&7笔记中记载了这么一份神秘的配方。但是，为什么？&r"
	]
	quest.217A0236C9312C68.quest_desc: [
		"暮色森林的要素是&#56C000地&r。它&#56C000沉积&r、划定&#56C000边界&r，又在边界之上&#56C000生长&r。"
		""
		"这里的回应物是活根、蝉罐子和萤火虫罐子。"
		""
		"在这里，用瓶与塞可以收集到瓶装暮光。"
	]
	quest.217A0236C9312C68.title: "暮色森林"
	quest.21CD29A550619BBF.quest_desc: [
		"云母钢锭由三块&a炫彩境云&r和六种天境材料合成，可用于把重力晶装备升级成云母钢装备。升级还需要黄金地牢里的&a锻造模板&r。"
		""
		"这片澄澈长空的云层与矿物，都落进了这枚粉红色的锭里。"
	]
	quest.22998D294F7048E2.quest_desc: ["这些&a塔&r各有其不同的功能，使用时可以参照对应描述，并配合相应的物品或&a过滤卡&r使用。"]
	quest.22998D294F7048E2.title: "塔"
	quest.22BBDE618BB134FE.title: "工业发酵机"
	quest.23110CF42C7F4E33.quest_desc: [
		"&a传送机&r与&a传送机框架&r配合使用组成传送器：传送机放在底部，传送框架围出一个中间空出两个方块的门形。"
		""
		"传送器建成后，可以在相同频率的传送器之间传送，也可以通过&a便携传送器&r传送到相同频率的传送器。"
	]
	quest.235FDE6DBE018EDE.quest_desc: ["&a无伤&r击败滑行魔石获得。"]
	quest.236B9D3A654D936D.quest_desc: [
		"交流发电机把&a应力&r变成电力，五彩脉冲水晶把&a魔源&r和&a灵气&r变成电力。"
		""
		"特斯拉线圈可以&a消耗电能&r给物品充能。"
		""
		"&o由此你获得了电，它可以作为一个通用的转换节点，统一各种“能源”，也可以接入电网，方便地传输。后续单列「电力生产」一章叙述。&r"
	]
	quest.236B9D3A654D936D.title: "电力时代"
	quest.23801395A0C28C71.quest_desc: [
		"&o符文祭坛把要素“写”了下来——不是装进瓶子，而是变成一条可以携带、可以调用的规则。&r"
		""
		"用三样材料与火之精华在祭坛上刻下这一笔：从此，&#FF5A01燃烧&r本身可以被仪式唤起。"
	]
	quest.24015ACDFF37D790.quest_desc: ["用瓶与塞从主世界的灵气场里收集来的。"]
	quest.242542377899CEDB.quest_desc: [
		"&a灵魂镭射钻基座&r与镭射钻基座用法相同，在其中放入&a蓝色镭射聚焦透镜&r，其下方如果有监守者，则可以通过给监守者造成伤害获取&a灵魂&r。"
		""
		"灵魂可以被&a灵魂促速器&r消耗，用于加速其所指向的方块。"
	]
	quest.242542377899CEDB.title: "灵魂涌动"
	quest.261B8F2A6269ABE9.quest_desc: ["使用&a压力室&r制作。"]
	quest.26C4569F0CA4E7D7.quest_desc: [
		"！？粉碎轮粉碎粉碎轮？！"
		"&a&l用粉碎轮粉碎粉碎轮，粉碎轮会被粉碎轮粉碎吗？&r"
	]
	quest.26C4569F0CA4E7D7.title: "粉碎轮"
	quest.26D8E6C6A1E587BD.quest_desc: [
		"&o&6作为冷冻人的完美升级，永冻继承了冷冻人的本能，却拥有对冰霜更强的掌控力。&r"
		""
		"&o&6即便文明已成尘埃，它依然在废墟中机械地执行着冷却一切的终极指令。&r"
		""
		"&a永冻&r是冷冻人的小Boss变种，击败它可以获得&a霜截棍&r。"
	]
	quest.26DCF8DA35F5CEA6.quest_desc: [
		" 谜题羊树丛藏在魔法森林里，一个树丛里只有一只&a谜题羊&r，它比普通的羊大上许多。 "
		""
		"它不会攻击你，只是等着你把&a十六种颜色的羊毛&r凑齐，全部交给它，你就会获得你想要的奖励。"
	]
	quest.27219131E0E42F88.quest_desc: ["用&a热带鱼&r喂食幼年利维坦可以驯服它，然后它就能用不成熟的深渊之力帮助你战斗。"]
	quest.2740A375D6EBCB05.title: "要素流体"
	quest.276452D7404A158A.quest_desc: ["使用&a罗纳扎通灵术&r制作。"]
	quest.27F647FAFC46B251.quest_desc: [
		"&a深渊祭品&r可以用于召唤利维坦。"
		""
		"它的合成材料除了海洋之心均能在沉沦之城中获得；宝藏房中有一张&a埋藏的宝藏地图&r，可以帮助你获得海洋之心。"
	]
	quest.28A287F38BC6D9D6.quest_desc: [
		"重力晶矿石上方没有方块阻挡时，会持续地反重力&a向上&r抬升。"
		""
		"对重力晶矿石附神可以得到神炼重力晶矿，用其制作的工具具有&a反重力&r属性。"
	]
	quest.2A0D63839EC06CB6.quest_desc: [
		"&o&7昨夜又做了那个梦：三块互不相同的要素结晶，连同红石，用燧石捣碎，拿碗装起来。&r"
		""
		"&o&7醒来时我尝试复刻这个配方，于是得到了一撮发着微光的粉末。&r"
		""
		"世界盐不是任何一种要素，它是它们的调和者：像凡俗世界的盐一样，它自己不成滋味，却能让彼此最暌离的要素，在同一件东西里共处。"
	]
	quest.2A0D63839EC06CB6.title: "世界盐"
	quest.2A90934B95C717BC.quest_desc: [
		"森林仪式借助黄金的特性将原料的力量灌注入一棵鲜活、生长的树苗之中。投入森林仪式的材料向树苗“描述”希望重现或转化的规律，金叶粉借仍在生长的生命把这份描述写回现实。"
		""
		"为进行森林仪式，你需要制作一些金叶粉。你的第一份金叶粉由&a下落的铁砧&r砸中黄金叶获得。你还需要准备一些木基座，在&a砧板&r上用闪耀纤维右键去皮橡木原木以获取。"
	]
	quest.2A90934B95C717BC.title: "森林仪式"
	quest.2B008EB17CABF755.quest_desc: ["所以为什么有这么多种塑料？"]
	quest.2C4674EF49DCE846.quest_desc: [
		"这个包里已经调好了常用设置：&a小地图&r在右上角，&aHUD&r摆在该在的位置，&a按键&r也尽量避开了互相冲突。"
		""
		"你改过的设置不会被更新覆盖。想回到预设，删掉config里对应的文件，下次启动会补回来。"
	]
	quest.2C4674EF49DCE846.title: "默认配置说明"
	quest.2C96F0369D75B59D.quest_desc: [
		"欢迎来到&a天境&r，这里是主世界之上的澄澈长空。这片天空被某种神秘而强大的邪恶力量所影响，太阳悬在天顶&a永不落下&r。"
		""
		"初次进入天境时，你会获得一本名为&a天境传说&r的指南书。去读一读它吧，聆听这片天空讲述它自己的故事与传奇。"
	]
	quest.2CC22C2203005BFF.title: "精炼厂"
	quest.2CC8F070EF7584BD.quest_desc: [
		"在高压下把糖、腐肉、气凝胶压在一起，得到了一坨黏糊糊的东西。"
		""
		"喂食它所求的&a食物&r，它便开始吞噬附近的物品并&a蔓延&r，留下一些有用的东西。"
		""
		"&6&o没人知道它们运作的原理，但它好像不知怎的……有生命？&r"
	]
	quest.2D72B8B451B12DFB.quest_desc: [
		"&a灌注室&r向物品灌注魔源以合成物品。"
		""
		"在这个过程中，如果灌注室周围的基座上有物品存在，物品的信息也会被一同灌注。"
	]
	quest.2D72B8B451B12DFB.title: "灌注室"
	quest.2D9A7BCB69358AFC.quest_desc: [
		"&o&6下界合金巨兽，就像它的“亲戚”红石巨兽（注：来自Minecraft Dungeons）一样镇守着一座锻造厂，虽说这座锻造厂比烈焰锻造厂小得多，但它依然强大。&r"
		""
		"当你走向下界合金巨兽&a所在的平台&r中央时，它便会从沉睡中苏醒。"
	]
	quest.2D9A7BCB69358AFC.title: "下界合金巨兽的试炼"
	quest.2E5D92132F9FA3DC.quest_desc: [
		"&o你利用&a自然祭坛&r&o和&a特斯拉线圈&r&o，炼出了第一块钢锭。从这块钢开始，机器的部件才真正称得上精密。&r"
		""
		"&o&m其实我也不知道为啥能想出这么神秘的配方&r"
	]
	quest.2E5D92132F9FA3DC.title: "钢锭"
	quest.2EC65ED47EDA8740.quest_desc: ["由它发射的鸣雷槊可穿透焰魔的盾牌造成伤害。"]
	quest.2F074ADCF3BB9078.quest_desc: [
		"&a娜迦庭院&r是森林深处一片被绿篱与石柱围起来的空地，整齐得不像自然生成。"
		""
		" 庭院中央盘着一条蛇形的巨兽——&a娜迦&r，它的鳞片能破开&a巫妖怪塔&r的魔法壁垒。"
	]
	quest.2F4141AE42BB5E86.quest_desc: [
		"灵魂锻造厂是猪灵们为了创造恐怖的战争机器而在&a下界&r修建的大型建筑。"
		""
		"其间沉睡着一只可怕的&a下界合金巨兽&r。"
		""
		"这个结构可用&a巨兽之眼&r寻找。"
	]
	quest.2F4141AE42BB5E86.title: "灵魂锻造厂"
	quest.2F80A4788FDBB0B5.quest_desc: [
		"这是一个高级工作站，用于将各类装备和材料&a融合&r在一起，以做成更强的装备。"
		""
		"与铁砧不同，它下方没有方块支撑时&a不会下落&r，使用时&a不会损坏和消耗经验&r。"
	]
	quest.30888D82985D06FE.quest_desc: [
		"&a寻觅之眼&r能够打开一张星图：它在星光维度内指向生物群系、Boss结构与普通结构。"
		""
		"&o注意：寻觅之眼只在星光维度内生效，而且收回时有两成概率碎掉。&r"
	]
	quest.30B6340921229929.quest_desc: ["&o&7紫水晶将你带到了&r&o&a装满水的炼药锅&r&o&7前。&r"]
	quest.30B6340921229929.title: "水之结晶"
	quest.30BB47BC4D75F040.quest_desc: [
		"欢迎来到&a暮色森林&r，一个被永恒之夜笼罩的森林世界。"
		""
		"&o这里曾孕育了十分繁荣的文明，但是你未能亲眼目睹。如今永恒之夜笼罩着这里，森林中仅存着一些遗迹、葱郁的树木及奇怪的生物。&r"
	]
	quest.31208139567F93AE.quest_desc: [
		"陨石中这个神秘的方块，用任何现有的手段都无法破坏——镐子撬不动它，爆炸也伤不到它。"
		""
		"&l但是肯定有什么办法能把它带回去。&r"
		""
		"&7&o笔记里提到过一种&a&l成分说不清楚的混合物&r&7&o，也许该拿它试试？&r"
	]
	quest.31208139567F93AE.title: "神秘方块"
	quest.3122552A78D4DDA5.quest_desc: [
		"古代工厂深埋于&a主世界&r地下深处，这里已经多年无人造访。"
		""
		"在古代工厂的核心区域，古文明的造物&a先驱者&r正在那儿沉睡着。"
		""
		"这个结构可用机械之眼寻找。"
	]
	quest.3122552A78D4DDA5.title: "古代工厂"
	quest.312538FA84554CFC.quest_desc: [
		"荆棘高地的巨魔洞穴里，由普通黑曜石围成的宝箱中可以找到&a魔豆&r。"
		""
		"&m&o众所周知魔豆曾经把开心消消乐的村长顶上了天，现在还没下来。&r"
	]
	quest.34164812034BC9A0.quest_desc: [
		"&o&6末影守卫盘踞在废弃堡垒的最深处，用末影与虚空之力惩罚入侵者。&r"
		""
		"当你靠近废弃堡垒第三层中心的&a虚空祭坛&r后，便会生成末影守卫。"
		""
		"&o&m末影守卫是否太没地位了，就掉一个护手？而且boss房间还要我自己挖进去？？？&r"
	]
	quest.34164812034BC9A0.title: "末影守卫的试炼"
	quest.34172736AC658A51.quest_desc: ["通过对应的&a下界合金套装&r加上&a锻造模板（咒魂升级）&r和咒魂锭在锻造台升级而成。"]
	quest.34172736AC658A51.title: "咒魂套装"
	quest.3453F3AF03FF04C4.quest_desc: ["&o&m（没有人觉得这个章节排布看起来很像有丝分裂吗）&r"]
	quest.348FD640D0B99AE2.quest_desc: [
		"&o&6卫城的高级守卫，手持巨斧的巨型鳌虾，拥有无与伦比的力量。&r"
		""
		"&o&m其实卫城有最弱的小boss和最强的小boss。&r"
	]
	quest.348FD640D0B99AE2.title: "击杀巨钳守卫"
	quest.351E49E49FA9FCEC.quest_desc: ["占位用"]
	quest.3582A8AFBE363D4B.quest_desc: [
		"炼药锅是这个世界给你的第一只容器。撒上一把&a世界盐&r，它就成了一只能容纳万物的容器。"
		""
		"动力搅拌器把搅拌从一个动作变成一道工序，&a转速&r决定搅得多快。"
		""
		"烈焰燃烧室也是一项必不可少的设备，有些东西只有在足够的&a热&r里，才肯彼此接纳。"
	]
	quest.3582A8AFBE363D4B.title: "混合搅拌"
	quest.35CE21DCABAAF10A.quest_desc: [
		"&o&6先驱者，古人制造的机械凋灵，拥有强大的破坏力。&r"
		""
		"手持&a下界之星&r右键古代工厂中沉睡的先驱者，便能将其唤醒。"
	]
	quest.35CE21DCABAAF10A.title: "先驱者的试炼"
	quest.366A7FDB98BD9216.quest_desc: [
		"&a超级火把&r可以阻止附近大范围内的敌对生物刷新，右击可以打开范围显示。"
		""
		"与之相对的有&a恐惧灯&r，可以阻止附近大范围内的非敌对生物刷新。"
	]
	quest.3676A11CC0AC3510.quest_desc: [
		"被诅咒的金字塔内部错综复杂，藏有无数的宝藏。但探索的同时要小心看守此处的骷髅狗头人，以及无处不在的陷阱。"
		""
		"使用刷子刷扫诅咒金字塔中的&a可疑的沙子&r有概率获得沙漠项链，它可以用来唤醒远古遗魂。"
	]
	quest.3686997CB148E9BF.quest_desc: [
		"The deciphering process cannot rely on a steady, brutal supply of power. The structure inside the relic is more like a precision instrument: it needs the right single pulse of energy at the right moment."
		"The Energy Capacitor stores and releases that energy, so that no calibration is ruined by an uncontrolled surge."
	]
	quest.368C96B399AD1368.quest_desc: [
		"&o符文祭坛把要素“写”了下来——不是装进瓶子，而是变成一条可以携带、可以调用的规则。&r"
		""
		"用三样材料与秩序之精华在祭坛上刻下这一笔：从此，&#D8D7F0约束&r与&#D8D7F0重复&r可以被仪式唤起。"
	]
	quest.37F411FC6258C723.quest_desc: ["&o现在你可以知道荧石之门的另一边是什么了。&r"]
	quest.37F411FC6258C723.title: "以防你挖不到荧石"
	quest.380E92E17E92D38B.quest_desc: ["&o&m想要多少应力自己拿（？）&r"]
	quest.380E92E17E92D38B.quest_subtitle: "蒸汽时代"
	quest.380E92E17E92D38B.title: "应力生产（其三）"
	quest.3811626F7A0570C2.quest_desc: [
		"&o把地之结晶放进灌注室，魔源会先把它浸透。&r"
		""
		"基座上的绿色刚玉簇截留住其中的环境信息，只让最纯净的部分沉下来。"
		""
		"于是你得到土之精华：它不再记得自己压着哪一段年轮，只记得&#56C000沉积&r、&#56C000边界&r、&#56C000生长&r。"
	]
	quest.3811626F7A0570C2.title: "土之精华"
	quest.382FD077B4CB5BA6.quest_desc: ["&o应该不能吧……&r"]
	quest.382FD077B4CB5BA6.title: "以防你打不过烈焰人和末影人"
	quest.389232F20FD67796.quest_desc: [
		"青铜地牢是由雕纹石与岗哨石组成的阴森迷宫，内部充斥着无数的哨卫石械。"
		""
		"在迷宫内部最庞大的昏暗房间的平台之上，沉眠着古老迷宫的主脑中枢，青铜钥匙的保管者——&a滑行魔石&r。"
	]
	quest.389232F20FD67796.title: "造访青铜地牢"
	quest.38F89B3C95DB51AC.quest_desc: ["在天境中，将紫水晶碎片丢入金黄境云中获取。"]
	quest.397C219C667CE90A.quest_desc: ["用瓶与塞从天境的灵气场里收集来的。"]
	quest.3992BDF384165566.quest_desc: ["烧炼来自于黄铜地牢的&a风锻套装&r获得。"]
	quest.3ACB112A6253261F.quest_desc: ["使用&a流体工作台&r制作。"]
	quest.3ADEEEDFEED6AFAA.quest_desc: [
		"&o&7你试着拆下陨石中镶嵌的神秘方块，却发现现有的手段都破坏不了它。你决定再看看笔记。&r"
		""
		"&o笔记中夹着的那几页里还有一行小字：&r"
		"{@pagebreak}"
		"&a陨石的外壳&r和内部包裹的&a赛特斯石英&r似乎对这个世界有特殊的回应。把它们分别&a磨成粉&r，再与&a世界盐&r在工作盆中混合，加入&a熔岩&r，并&a冲压塑形&r，会得到一种&l&a未知的粉末&r。"
		""
		"&o先照着做吧，看看会得到什么东西。"
	]
	quest.3ADEEEDFEED6AFAA.title: "陨星启示"
	quest.3B031C44C9ACA605.quest_desc: ["星辉水晶碎片掉落自&a星辉水晶簇&r或&a晶化蛾&r，有红色和蓝色两种。"]
	quest.3B031C44C9ACA605.title: "星辉水晶碎片"
	quest.3B39350B3C6A7D55.quest_desc: [
		"&o符文祭坛把要素“写”了下来——不是装进瓶子，而是变成一条可以携带、可以调用的规则。&r"
		""
		"用三样材料与土之精华在祭坛上刻下这一笔：从此，&#56C000沉积&r与&#56C000生长&r可以被仪式唤起。"
	]
	quest.3BBB6BA364026473.quest_desc: ["灵魂锻造厂中似乎有一个&a&l隐藏房间&r，去找找看？"]
	quest.3BDF422CB23EB76B.quest_desc: [
		"放在背包内的&a时间之瓶&r会记录并存储你在游戏中度过的时间，存储的时间可以在你需要时释放出来。"
		""
		"对准一个方块右键，可以暂时&a加速&r该方块的更新速度，多次右键效果可以叠加，但同时消耗的时间也会翻倍。"
	]
	quest.3E2DFA7DE032E3E8.quest_desc: [
		"烈焰竞技场坐落在&a下界&r，虽然已经废弃多年，但其间的烈焰从未熄灭。"
		""
		"它是&a焰魔&r的栖居之所。"
		""
		"这个结构可用&a烈焰之眼&r寻找。"
	]
	quest.3E2DFA7DE032E3E8.title: "烈焰竞技场"
	quest.3F1CCBCFEECF80F1.quest_desc: [
		"&a方块制造机&r在侧面识别流体，从下方读取目标产物，并向上方容器输出产物。"
		""
		"它有许多等级，提升等级可以提升生产速度。等级的提升会随着发展逐步解锁。"
		""
		"一些配方会消耗流体。若直接放置流体源，无论方块制造机的材质是什么，每次都只刷出一个。可以使用其他提供流体的&a容器&r替代流体源，以实现更高效的生产。"
	]
	quest.3F64EB93903B0250.quest_desc: [
		"刚玉可以在&a主世界地下浅层&r（y值0~64，非海洋生物群系）找到一大片，并且通常为两种颜色一起生成。在灌注室中可以&a转化&r为不同的颜色。"
		""
		"刚玉被放置在地下较低的层数时，其会缓慢向上方生长（似乎也不是很缓慢？），且伴生一些刚玉簇。"
	]
	quest.3F64EB93903B0250.title: "刚玉"
	quest.3F8681ECC0F4EC99.quest_desc: ["烈焰竞技场被&a炽燃遗魂&r守卫着，击杀其中一只，你便可以获得唤醒焰魔的资格——&a炽燃余烬&r。"]
	quest.400F9EA8BED6E390.quest_desc: [
		"风帆需要使用坚韧布料制作。"
		""
		"&o&m或者你也可以竖一个羊毛坨子，如果你想的话。&r"
	]
	quest.400F9EA8BED6E390.quest_subtitle: "大风车"
	quest.400F9EA8BED6E390.title: "应力生产（其一）"
	quest.40501041AF4EBAA3.quest_desc: [
		"The aura of the six dimensions follows different rules, and when they come near one another they usually only interfere. The Aura Diode splits them apart, corrects them, and guides them into a single stable observation line."
		"Now, at last, you can let aura from different worlds take part in the same experiment at the same time."
	]
	quest.40A0FF3C16F17A99.quest_desc: [
		"&o森林仪式记下了生命面对这个维度时留下的情绪。&r"
		""
		"&#56C000地&r之印记里是恐惧——让生命面对幽暗与未知。"
	]
	quest.424A36FF905942D5.quest_desc: [
		"紫水晶已向你揭示了蕴藏于主世界灵气场中的&#3EDCFF水&r，你得到了它的回应。"
		""
		"接下来，试试用&a瓶与塞&r收集来自主世界的灵气，看看又会发生什么。"
	]
	quest.424A36FF905942D5.title: "瓶装阳光"
	quest.4253B342CB49E078.quest_desc: [
		"&o&7笔记翻到新的一页。&r"
		""
		"&o接下来有两条路：继续你的探索之旅，发现六重要素的&a更多秘密&r&o，或是破译陨石中心那个&a神秘方块&r&o。&r"
		""
		"&o这就是本章的全部主题。&r"
	]
	quest.42B654686E7E6BFC.quest_desc: [
		"烈阳巨灵在常态下无法被任何形式的攻击所伤害。它会发射两种晶体球："
		""
		"被&a滚炎球&r命中会造成伤害和爆炸，且有一定概率被点燃，可以被攻击打碎；"
		""
		"被&a冰结球&r击中会造成小额伤害，受到玩家攻击后会改变轨迹向攻击方向飞出，撞击实体或方块后破碎。"
		"{@pagebreak}"
		"当冰结球被打飞后命中烈阳巨灵，烈阳巨灵将会受到伤害，分裂出一只烈阳仆从，并进入&a冷冻状态&r。冷冻状态期间你将可以通过正常手段伤害烈阳巨灵。"
		""
		"当然，若是你厌倦了和烈阳巨灵打半个小时的保龄球的话，不妨试试&a冰霜弹&r与&a冰霜权杖&r，它们可以直接发射冰结球并冷冻烈阳巨灵。前者可以&a直接合成&r，后者发现于&a青铜地牢&r的藏宝箱中。"
	]
	quest.431A6B56EE43ADEE.quest_desc: [
		"你收集到了来自主世界的灵气，连同其中承载的&l&n环境信息&r与&l&n要素信息&r。"
		""
		"接下来，继续这场远征，踏足其他维度，去回应来自那些维度的呼唤。"
		""
		"&o注：本章任务线仅围绕主世界的&#3EDCFF水&r&o展开，另有&l&a「维度，要素和这个世界」&r&o一章单列所有元始要素的相关内容。&r"
	]
	quest.431A6B56EE43ADEE.title: "六重要素"
	quest.4363AE8363EC43A6.quest_desc: [
		"有些配方只能在&a动力合成器&r上做，工作台做不出来。"
		""
		"&o尤其是有一些小工具需要动力合成器制作，可以查看这张任务卡有哪些后续任务。&r"
	]
	quest.4363AE8363EC43A6.title: "动力合成器"
	quest.44B6CBFAD6C215C0.quest_desc: ["暮色森林传送门的形状可以任意，只要有&a至少四格&r连续的水源，并且每个水源相邻的草方块上都有&a植物&r，然后丢入一颗&a钻石&r，传送门即可开启。"]
	quest.44B6CBFAD6C215C0.title: "暮色森林传送门"
	quest.460FC1911724CF88.quest_desc: ["&o说真的，虽然它实际上只是一把花里胡哨的镐子，但它&a真的很酷&r&o，不是吗？"]
	quest.46B818618F767629.quest_desc: [
		"苍灰树苗是优良的灵气载体，是进行各类森林仪式重要的树种。"
		""
		"苍灰树苗可以由&a嗅探兽刨挖&r获得，也可以用&a森林仪式合成&r。"
	]
	quest.46B818618F767629.title: "苍灰树苗"
	quest.46FAF2499DF8D446.quest_desc: [
		"&a传送石碑&r会自然生成于&a村庄&r中，也可以自己合成。"
		""
		"右击即可激活，再次右击以打开GUI，可以选择已激活的传送石碑并传送。"
	]
	quest.46FAF2499DF8D446.title: "传送石碑"
	quest.4732C23C21EA0CCE.quest_desc: [
		"&o把风之结晶放进灌注室，魔源会先把它浸透。&r"
		""
		"基座上的黄色刚玉簇截留住其中的环境信息，只让最纯净的部分沉下来。"
		""
		"于是你得到气之精华：它不再记得自己吹过哪片云，只记得&#FFFF7E变化&r、&#FFFF7E传播&r、&#FFFF7E自由&r。"
	]
	quest.476E0AEAFEDFA031.quest_desc: [
		"愉悦升到高处就是欣快。"
		""
		"&#FFFF7E风&r让生命体验轻盈——而欣快轻盈到让人忘了自己还需要落地。"
	]
	quest.477C7D68B338367C.quest_desc: [
		"安山合金由安山岩与铁锭或锌锭在&a砧板&r上合成。它比铁轻，却能把旋转稳稳地传下去。"
		""
		"&o&7你敲出了第一块安山合金。&r"
		""
		"&o&m但是为什么是砧板？！&r"
	]
	quest.477C7D68B338367C.title: "安山时代"
	quest.47B79E15AB741060.title: "自动化工程师装配台"
	quest.47FCF20CC8A5E09D.quest_desc: ["在&a天赐块&r上放置一个&a雕刻月螟仙人掌果实&r可以召唤&a天赐傀儡&r，它可以拦截砸向地面的陨石，防止它们摧毁地表上的建筑。"]
	quest.47FCF20CC8A5E09D.title: "天赐傀儡"
	quest.481ECA1B87829938.quest_desc: ["这是一个更好的&a获得钢&r的方法&m（吗？）&r。除此之外，它还能精炼一些&a其他的材料&r。"]
	quest.481ECA1B87829938.title: "粗制高炉"
	quest.48407C982D11D8DC.quest_desc: [
		"刚玉是优良的魔法材料，能吸收环境信息。"
		""
		"将刚玉置于基座上，以魔源为推动力，周围物品中的环境信息会被刚玉截留，要素结晶中的环境信息也会被吸收，只留下&l&n纯净的要素信息&r；结晶被浸透、被拆开、被重排——凝出来的东西就是&a魔法精华&r。"
	]
	quest.48407C982D11D8DC.title: "魔法精华"
	quest.485146C723E79D3B.quest_desc: [
		"机械手是你方块手的完美复制品，它可以&a模仿你的交互行为&r。"
		""
		"给它设定一个程序，它便会一遍遍地重复下去。"
	]
	quest.485146C723E79D3B.title: "机械手"
	quest.4882FCF67676C010.quest_desc: [
		"&o&6焰魔，烈焰之主宰，至尊之战神。&r"
		""
		"使用&a炽燃余烬&r右键点击烈焰竞技场顶层中心的&a烈焰祭坛&r召唤焰魔。"
	]
	quest.4882FCF67676C010.title: "焰魔的试炼"
	quest.499464A11D38D71F.quest_desc: [
		"将&a钢锭&r丢在地上，然后在旁边引发一场&a爆炸&r，就可以获得&m&o压缩钢锭&r&a压缩铁锭&r。"
		""
		"它具有独特的性能，能与&a压力&r和&a热量&r很好的协作。"
	]
	quest.4A540375BBDC6D05.quest_desc: [
		"要获得各类机壳，你首先需要种植&a苍灰树&r。"
		""
		"机壳的骨架不能随便找块木头，它要在灵气里长期不变形，只有苍灰树做得到。"
	]
	quest.4A540375BBDC6D05.title: "安山机壳"
	quest.4B699022B1FD8A00.quest_desc: [
		"似乎你已经注意到了紫水晶碎片的异样。"
		""
		"受异变的影响，紫水晶碎片在与灵气场中的要素&l&n共振&r&r。"
		""
		"跟随紫水晶碎片的指引，去寻找&l&n回应物&r&r，让紫水晶与外溢的要素接触，或许会得到你想要的收获。"
	]
	quest.4BB8027A2703FC28.quest_desc: ["&o&m以灾变的风格，这个船锚居然不是一把镐子？&r"]
	quest.4C173E38BEDFEB4A.quest_desc: [
		"傀儡锻造厂是星光人铸就战争机器的地方，如今只剩下停摆的流水线。"
		""
		"它是&a星光傀儡&r的诞生之处。"
	]
	quest.4CF8C2A8077F34B8.quest_desc: [
		"&o&6星光傀儡，星光人制造的机械造物，为抵御先知预言中毁灭全族的灾难而生，曾经拥有厚重的装甲和无与伦比的力量。&r"
		"{@pagebreak}"
		"战斗开始时，星光傀儡会进入&a充能状态&r，此时其将维持&a无敌&r。"
		""
		"熄灭所有为星光傀儡充能的&a能量方块&r后，星光傀儡会进入&a破防状态&r。破防后仅有&a7次&r有效攻击机会，请尽可能使用单次高伤武器输出。"
		"{@pagebreak}"
		"当星光傀儡的&a剩余血量≤20%&r时，它会失去无敌被动，且永久不会切换充能状态与破防状态，从这里开始，你可以随意使用正常手段攻击星光傀儡并造成伤害。"
	]
	quest.4CF8C2A8077F34B8.title: "击杀星光傀儡"
	quest.4D69672AA9A6CB0D.quest_desc: [
		"沉沦之城出现在&a主世界&r深海的海面上，这是一座建筑技巧极其高超的古代遗址。"
		""
		"在这里用一种古老的仪式便能够召唤&a利维坦&r。"
		""
		"这个结构可用&a深渊之眼&r寻找。"
	]
	quest.4D69672AA9A6CB0D.title: "沉沦之城"
	quest.4E8041B1FBD6669F.quest_desc: [
		"末地的要素是&#626262混沌&r。它&#626262崩解&r既有的一切，把一切推向&#626262未知&r，只留下&#626262尚未固定的可能&r。"
		""
		"这里的回应物是末地传送门。"
		""
		"在这里，用瓶与塞可以收集到瓶装黑暗。"
	]
	quest.4E8041B1FBD6669F.title: "末地"
	quest.4F1594D45E71BD67.quest_desc: ["材料中承载的要素信息与环境信息，被一同灌注入苍灰树苗中，森林仪式记录下了生命面对世界时留下的情绪，将其具象化为一种木质的雕像，也就是&a印记&r。"]
	quest.4F1594D45E71BD67.title: "印记"
	quest.505D9FE85D283F43.quest_desc: [
		"卫城是生成于&a主世界&r暖水海洋生物群系的宏伟建筑群。"
		""
		"它是风暴女皇&a斯库拉&r与其追随者所栖身的圣地。"
		""
		"这个结构可以使用&a风暴之眼&r寻找。"
	]
	quest.505D9FE85D283F43.title: "卫城"
	quest.516C33B1C8134654.quest_desc: [
		"&o&6斯库拉，一个古希腊传说中女性海妖的名字；而你登临卫城之巅，面对的那个搅动风暴的存在，或许就是风暴本身的女王——也是斯库拉。&r"
		""
		"登上卫城的顶层，你就来到了boss所在的建筑。准备好以后&a右击正中心的船锚&r，便可唤来斯库拉开始战斗。"
	]
	quest.516C33B1C8134654.title: "斯库拉的试炼"
	quest.526331691A38FD42.quest_desc: ["&o预留给植物魔法的位置。&r"]
	quest.526FED59584C6513.quest_desc: [
		"&a巫妖怪塔&r是一座哥特式的尖塔，塔身的砖石被咒语护着，连塔周围的空气都带着压迫感。"
		""
		" 塔顶的&a暮光巫妖&r握着权杖，那权杖能驱散&a沼泽&r的毒蚊、解除&a黑暗森林&r的失明、挡住&a积雪森林&r的严寒。"
	]
	quest.52E4D111AF7DFF20.quest_desc: [
		"&a雪怪洞窟&r藏在积雪森林的暴风雪里，那场风雪本身就是一道咒。 "
		""
		"洞窟深处的&a雪怪首领&r披着厚厚的毛皮，那毛皮能挡住&a极光冰川&r的寒风。"
	]
	quest.54766B34784DB721.quest_desc: [
		"&o&7圣杯被放上工作台，森林各处的材料向它聚拢，凝成一枚淡蓝色闪闪发光的锭。&r"
		""
		"&a暮色锭&r能把boss的灵魂从奖杯里抽出来，注入&a收容罐&r（幻影骑士除外）。"
	]
	quest.54946257C2AB9DCF.quest_desc: [
		"为了利用要素结晶，你需要做一些准备。"
		""
		"黄金是优良的导体，能引导要素流动，在森林仪式中充当人与自然的媒介。首先需要将其转化为闪耀纤维并加以利用。"
		""
		"你的第一份闪耀纤维需要主手持金锭，副手持线，右击暮色森林中的&a树篱&r获取。这个方法掉率比较低，而且由于树篱多刺，你会&a受到伤害&r。"
	]
	quest.54946257C2AB9DCF.title: "闪耀纤维"
	quest.54CC0D96675F33E8.quest_desc: [
		"为了与这个世界建立联系，你首先需要收集&a紫水晶碎片&r。"
		""
		"或许制作一把占卜杖可以帮助你发现紫晶洞。"
	]
	quest.54CC0D96675F33E8.title: "紫水晶碎片"
	quest.5538B917632BBC54.quest_desc: ["用瓶与塞从暮色森林的灵气场里收集来的。"]
	quest.56952889BA57C65D.quest_desc: [
		"&o&6远古遗魂，一具巨大的棘龙骨架，沉睡在诅咒金字塔的最深处，静待挑战者的来临。&r"
		""
		"将&a沙漠项链&r挂在远古遗魂的脖子上，便可以唤醒它。"
	]
	quest.56952889BA57C65D.title: "远古遗魂的试炼"
	quest.571009D6DC3766FA.quest_desc: ["银青境云&l非常稀有&r地生成在天境的&a高空&r&o（大概y≥200）&r，为其附神可以得到&a炫彩境云&r，这是一种重要的合成材料。"]
	quest.572DA574E340A229.quest_desc: [
		"建筑小帮手旨在使建筑变得更容易一些。"
		""
		"阅读&a「笨蛋专用小工具」&r以获得更多相关信息。"
		""
		"&o&m这本书疑似有点bug？工具的贴图都没了，不过不影响阅读就是了。&r"
	]
	quest.572DA574E340A229.title: "建筑小帮手"
	quest.5781F26291987E67.quest_desc: [
		"&o森林仪式记下了生命面对这个维度时留下的情绪。&r"
		""
		"&#D8D7F0秩序&r之印记里是平和——让生命安于结构与恒常。"
	]
	quest.57E3CCC839CDA402.quest_desc: ["时间手杖消耗&a能量&r和&a时间流体&r对方块进行加速。"]
	quest.57E4DA3C7780AAAD.quest_desc: ["合金窑用于把两种材料熔在一起，制作一些&a合金&r。"]
	quest.57E4DA3C7780AAAD.title: "合金窑"
	quest.57F8ADC74552877F.quest_desc: [
		"&o符文祭坛把要素“写”了下来——不是装进瓶子，而是变成一条可以携带、可以调用的规则。&r"
		""
		"用三样材料与气之精华在祭坛上刻下这一笔：从此，&#FFFF7E传播&r与&#FFFF7E自由&r可以被仪式唤起。"
	]
	quest.5860A88B6FA1AC51.quest_desc: [
		"&o符文祭坛把要素“写”了下来——不是装进瓶子，而是变成一条可以携带、可以调用的规则。&r"
		""
		"用三样材料与水之精华在祭坛上刻下这一笔：从此，&#3EDCFF流动&r本身可以被仪式唤起。"
	]
	quest.589AA6E963E29909.quest_desc: [
		"&a天辉星门&r结构可用于在两地之间快速传送，可跨维度。"
		""
		"天辉星门需要正确搭建&a多方块结构&r才能使用，在没有天花板的维度必须&a露天&r使用。"
		""
		"进入符合要求的天辉星门后，你会看到表示其他星门的大星星显示在星空背景上，对着它们按&a右键&r或&a潜行键&r，片刻之后便能传送到目的地。"
		""
		"使用&a染料&r可以更改颜色，使用&a铁砧&r可以为星门重命名。"
	]
	quest.5971AA7E8234AA79.quest_desc: ["压力室"]
	quest.5971AA7E8234AA79.title: "压力室"
	quest.5A00C69798692D1B.quest_desc: ["天境的木材制作的木质工具，虽然耐久很低，但是可以&a加倍掉落&r。"]
	quest.5A00C69798692D1B.title: "天境木材"
	quest.5AA560228973D274.title: "重塑应用能源"
	quest.5B27D2BA57349AAF.quest_desc: ["看看资源生产多了什么东西"]
	quest.5CB6EA2A68A9037C.quest_desc: ["改良高炉支持&a输入输出自动化&r，同时还能通过外加&a高炉预热器&r加速精炼过程。"]
	quest.5CB6EA2A68A9037C.title: "改良高炉"
	quest.5D6FDC17D4284E3A.quest_desc: [
		"为五彩脉冲水晶提供&a魔源&r，它同时会消耗周围灵气场中的&a灵气&r，产出电力。"
		""
		"给五彩共鸣水晶供电，在周围有未装满的魔源罐时，会消耗电力产生&a魔源&r；周围没有未装满的魔源罐时，会消耗电力产生&a灵气&r，并扩散入灵气场中，直至&a达到上限&r。"
	]
	quest.5D6FDC17D4284E3A.title: "电力与魔源/灵气"
	quest.5E4647B964AD82A1.quest_desc: [
		"&a自然祭坛&r由六种印记——生命对世界的六种回应——在附魔装置中合成。"
		""
		"它汇聚一方天地中的灵气并将其灌注入物品中，自然的力量将不再局限于一方土地，而会成为贯通诸界、孕育万象的根源。"
	]
	quest.5E4647B964AD82A1.title: "自然祭坛"
	quest.5E6A08A57900AFE8.quest_desc: [
		"&o把水之结晶放进灌注室，魔源会先把它浸透。&r"
		""
		"基座上的蓝色刚玉簇截留住其中的环境信息，只让最纯净的部分沉下来。"
		""
		"于是你得到水之精华：它不再记得自己来自哪一口炼药锅，只记得&#3EDCFF流动&r、&#3EDCFF容纳&r、&#3EDCFF延续&r。"
	]
	quest.5E9797FB5209D7ED.quest_desc: [
		"&a九头蛇巢穴&r在火焰沼泽的中心，空气里全是烧焦的味道。"
		""
		" &a九头蛇&r盘在巢中，火焰伤不了它；杀死它，你就能得到暮色森林里最危险的美味。"
	]
	quest.5EDF156392CA0C8F.quest_desc: [
		"红石酸主要用于制作各类&a蓄电池&r，还可以快速腐蚀铜块使其被氧化。"
		""
		"除此之外，它还是一种&a优良的溶剂&r，可以将各种材料溶解在一起。"
	]
	quest.5F7B7E99A3288BD8.quest_desc: ["由圣石制作的石质工具，使用时有概率掉落&a神能晶片&r。"]
	quest.5FC00933683D6F6B.quest_desc: [
		"&o森林仪式记下了生命面对这个维度时留下的情绪。&r"
		""
		"&#FFFF7E风&r之印记里是愉悦——让生命体验轻盈与自由。"
	]
	quest.60362BA2A41B4033.quest_desc: [
		"&o在开始之前，先来认识一下你所生活的世界吧。&r"
		""
		"&o这个世界由六大维度组成。六个维度各富集一种&l&n元始要素&r&o——主世界奔流的&#3EDCFF水&r&o、下界燃烧的&#FF5A01火&r&o、暮色森林沉眠的&#56C000地&r&o、天境回荡的&#FFFF7E风&r&o、末地无序的&#626262混沌&r&o，与永恒星光中恒定的&#D8D7F0秩序&r&o。&r"
		"{@pagebreak}"
		"&o这些要素&l&n没有物质实体&r&o，只是安静地充盈于各自维度的&l&n灵气场&r&o中，并在其中稳定存在。&r"
		""
		"&o不同维度之间互不联系，互不影响。存在连接各个维度间的传送门，但这种连接实在是太不稳定，只能勉强支持物品通过。&r"
		""
		"&o六种元始要素以不同的姿态书写着六个维度，遍入天地，组成了世界的方方面面。&r"
	]
	quest.6133B55F3B880EC1.quest_desc: ["石英神庙中有着一座神秘的&a紫水晶祭坛&r，可以将紫水晶蟹肉转化为受祝福的紫水晶蟹肉，可以帮助你与利维坦的战斗。"]
	quest.6256F04D11B48E39.quest_desc: [
		"动力冲压机用于把金属锭压成&a板状&r。"
		""
		"板是很多机件的中间形态。"
		""
		"注意它处理不来&a钢锭&r，需要其他的办法。"
	]
	quest.6256F04D11B48E39.title: "动力冲压机"
	quest.62FFB5BB68CF11F3.quest_desc: ["交流发电机与电动马达，能将&a电力&r与&a应力&r互相转化。"]
	quest.62FFB5BB68CF11F3.title: "电力与应力"
	quest.636F2AFB3BF2AC31.quest_desc: [
		"&a附魔装置&r由六种魔法精华在森林仪式中合成。"
		""
		"它把基座上的材料与中心物品合成到一起，是一座连接万物的桥梁——魔法与科技，魔源与灵气，生物与世界。"
		""
		"&o&m其实就是个特效更多的森林仪式（？）&r&r"
	]
	quest.636F2AFB3BF2AC31.title: "附魔装置"
	quest.6382FF32C9CD4C98.quest_desc: [
		"&a升级模板&r可以为建筑棒添加特殊升级，在锻造台中使用升级模板、建筑棒以及一个额外物品以添加。"
		""
		"下页展示了不同升级模板的功能。"
		"{@pagebreak}"
		"&a&l天使升级模板&r：允许在方块后方或半空中放置方块；"
		"&a&l销毁升级模板&r：破坏面向玩家一侧的方块；"
		"&a&l替换升级模板&r：用副手持有的方块替换目标方块；"
		"&a&l不毁升级模板&r：操作时不消耗耐久度；"
		"&a&l电池升级模板&r：使用能量代替耐久度进行操作。"
	]
	quest.6382FF32C9CD4C98.title: "建筑棒升级模板"
	quest.64DDBFEA863697E9.quest_desc: [
		"金属冲压机可以使用&a金属冲压模具&r对金属进行自动化成型，这其中便包括了各类&a齿轮&r。"
		""
		"&o沉浸的机器均得到增强：耗电量减少，处理速度加快。&r"
	]
	quest.64DDBFEA863697E9.title: "金属冲压机"
	quest.656B7D59A1F6492F.quest_desc: ["&o这不可能。&r"]
	quest.656B7D59A1F6492F.title: "以防你不知道主世界是什么"
	quest.6576FFF207EECE9E.quest_desc: [
		"&o&6卫城的高级守卫，手持三叉戟的海马，拥有强大近身作战技巧与能力的优秀战士。&r"
		""
		"&o&m其实这是灾变里最像小怪的小boss。&r"
	]
	quest.6576FFF207EECE9E.title: "击杀沧溟巡守"
	quest.66005447331600B1.quest_desc: ["&a无伤&r击败武神女王获得。"]
	quest.66F862C570D8DC96.quest_desc: ["金琥珀获得自金橡树的树干，使用天境的&a高级斧头&r（紫晶、穹玉、重力晶、云母钢斧等）采伐或去皮以获得。"]
	quest.675FAAEE78133EB5.quest_desc: [
		"诅咒花园是星光维度中最深的角落，藤蔓之下埋着历代统治者的刑场。"
		""
		"&a月藤巨物&r就扎根在花园的尽头。"
	]
	quest.675FAAEE78133EB5.title: "造访诅咒花园"
	quest.6916611959D6968A.quest_desc: [
		"现世遗魂可以使用&a遗魂头骨&r召唤，使用&a嗅探兽蛋&r来驯服它。"
		""
		"驯服后的现世遗魂会主动攻击你的攻击目标，或者是将你作为攻击目标的生物。"
	]
	quest.691D79550FAD2ADE.quest_desc: [
		"要挑战武神女王，你需要先收集10枚&a胜利奖牌&r，作为足以挑战她的资格。她&a&l非常讲武德&r，在发起挑战后，会让你先出手第一招，此后战斗才算正式开始。"
		""
		"在战斗中，她会不时使用&a冲刺&r造成突击伤害，或召唤&a风暴雷球&r。若你使用反重力或飞行，武神女王也会飞到与你相同的高度；若你距离武神女王一定距离，她将会瞬移到你身后。"
	]
	quest.6951B60D890910D1.quest_desc: [
		"灵气场中的灵气在被抽取后并不会自动恢复。"
		""
		"但不用太担心，这并不是一个问题。你可以通过&a多种方式&r生产灵气，并扩散入灵气场中。"
		""
		"你唯独需要注意的一点就是：默认情况下，一片区域所能容纳的灵气是&a有上限&r的。"
	]
	quest.6951B60D890910D1.title: "灵气制造"
	quest.6B0C4D6CC6F590A4.quest_desc: ["&o纸箱牛逼。&r"]
	quest.6BA679217AD6DBB8.quest_desc: [
		"获得钢锭以后，接下来，就可以建造重型机械了。"
		""
		"但在那之前，首先需要搭建一台&a焦炉&r，以获得焦煤和杂酚油。"
	]
	quest.6BA679217AD6DBB8.title: "焦炉"
	quest.6BD5C4A261AF78A6.quest_desc: [
		"&o森林仪式记下了生命面对这个维度时留下的情绪。&r"
		""
		"&#FF5A01火&r之印记里是愤怒——让生命学会释放与爆发。"
	]
	quest.6BF71BFF3438B29B.quest_desc: [
		"&o&6你走过四个地牢，驱散了笼罩在天境的邪恶力量，古老的光明与黑暗之魂重新被释放。&r"
		""
		"击败烈阳巨灵后，天境维度的&a昼夜更替&r将恢复正常，并且你也可以使用&a日轮祭坛&r来改变时间。"
	]
	quest.6C49ACF7A8AF9DB9.quest_desc: [
		"&a虚素锭&r由&a合金炉&r锻造而成，是一种高级合金材料。"
		""
		"制作它，你需要收集星光维度中的各种材料，并击败那两位守在这里的Boss。"
	]
	quest.6CDD9C60114AF706.quest_desc: [
		"神能炉可用以给物品&a附神&r，也可用于&a修复&r工具和武器。"
		""
		"在神能炉下方放置&a神炼重力晶矿&r可以加速附神的过程，当然你也可以使用鼓风机批量附神。"
	]
	quest.6CDE0F370C954563.quest_desc: ["用闪耀纤维右键树叶，即可将树叶转化为&a黄金树叶&r。黄金树叶可以侵染周围的树叶，一段时间后收获，即可得到大量的黄金叶。"]
	quest.6CDE0F370C954563.title: "黄金叶"
	quest.6D0337DB8C14104E.quest_desc: [
		"这只是一个普通的方块世界，而你，是这个世界的一个普通人。"
		""
		"你原以为生活就会这样普通地继续下去，但不知道从哪一天开始，世界突然变得不一样了。"
		""
		"你说不上来怎么不一样了，但你发现了一本名为「本源远征」的笔记，也就是你手中这本任务书。"
		"{@pagebreak}"
		"&o注：此后&r正体内容&o表示笔记中的记录，斜体内容均表示旁白。&a绿色内容&r&o多为提示和指引，&7淡灰色内容&r&o多为描述玩家做了什么或剧情中发生了什么。&r"
		""
		"&o整合包世界设定中的内容第一次出现时，会&l&n加粗且加下划线&r&o标记，或使用&l「」&r&o标记。&r"
		""
		"&o齿轮形状的任务表示关键节点，圆角方形的任务表示可选任务或隐藏任务。&r"
	]
	quest.6D0337DB8C14104E.title: "引入"
	quest.6D1E3B2DB0CF6EB6.quest_desc: [
		"星光维度的要素是&#D8D7F0秩序&r。它强调&#D8D7F0结构&r、&#D8D7F0重复&r、&#D8D7F0恒常&r。"
		""
		"这里的回应物是盛开的星照睡莲、结种的石英硫块。"
		""
		"在这里，用瓶与塞可以收集到瓶装星光。"
	]
	quest.6D1E3B2DB0CF6EB6.title: "永恒星光"
	quest.6DDF94B179429870.quest_desc: [
		"&o-弱者才需要这个。&r"
		"&o-是的我就是弱者。&r"
	]
	quest.6DDF94B179429870.title: "以防你挖不到黑曜石"
	quest.6DE914EC13E3D516.quest_desc: [
		"&o&6深渊在注视着你。&r"
		""
		"当你击杀利维坦之后，&a珊瑚傀儡&r、&a渊灵祭司&r、&a渊灵术士&r便可在任意海洋类生物群系中稀有地生成。"
	]
	quest.6E5373E39669104B.quest_desc: ["类似下界传送门，用&a荧石&r搭建一个传送门框架，然后倒上一桶&a水&r，便能开启天境传送门。"]
	quest.6E879124E9249E36.quest_desc: [
		"轧机把金属进一步轧成&a棒&r与&a线&r。"
		""
		"注意它也处理不来&a钢锭&r。"
	]
	quest.6E879124E9249E36.title: "轧机"
	quest.6EC80EDEED6DBEE5.quest_desc: [
		"茫然再往前一步就是迷惘。"
		""
		"&#626262混沌&r让生命失去方向——而迷惘里，连“要去哪里”这个问题本身都不见了。"
	]
	quest.6ED362EAD1B8C171.quest_desc: [
		"庄严的白银地牢是天境不可侵犯的圣地，也是武神族人的休憩之所。"
		""
		"在这里，你可以见到神庙的守护人，武神一族的高级统治者，白银钥匙的保管者——&a武神女王&r。"
	]
	quest.704148E137D62A82.quest_desc: [
		"The outer layer of the Mysterious Cube is not ordinary meteor rock, but a sealed protective structure. Stable capacitors and controlled machining can strip away its useless shell step by step while preserving the circuitry inside that has not yet been destroyed."
		"This mainboard still cannot read any information, but it has provided the first operable interface for the deciphering to come."
	]
	quest.708C965D7191F1FF.quest_desc: [
		"紫晶石和穹玉晶石制成的工具和装备，性质&a恰好相反&r："
		""
		"&a紫晶工具&r初始强度较低，随着耐久的下降强度会增加；"
		"&a穹玉工具&r初始强度较高，随着耐久的下降强度会降低。"
		""
		"它们还可以用于制作一些饰品。"
	]
	quest.708C965D7191F1FF.title: "紫晶石和穹玉晶石"
	quest.71F2C2CF724481F9.quest_desc: [
		"合金炉生成于&a傀儡锻造厂&r的特定房间，它是一种专门用于冶炼合金或增产矿物的大型设备。"
		""
		"使用合金炉时需要同时输入燃料和&a冷却剂&r，如果长时间进行物品加工的合金炉没有冷却剂供应，那么合金炉将有&l&a过热自爆&r&r的风险。"
	]
	quest.72207EFC62718B7D.title: "精炼厂"
	quest.722B83DF6BDAAE12.quest_desc: ["&o这一支为沉浸工程模组添加的发电方式。&r"]
	quest.724CFEFED2FB7209.quest_desc: [
		"&o把秩序结晶放进灌注室，魔源会先把它浸透。&r"
		""
		"基座上的白色刚玉簇截留住其中的环境信息，只让最纯净的部分沉下来。"
		""
		"于是你得到秩序之精华：它不再记得自己排布过什么，只记得&#D8D7F0结构&r与&#D8D7F0重复&r。"
	]
	quest.724CFEFED2FB7209.title: "秩序之精华"
	quest.72B021AA3E3944F3.quest_desc: ["远古树叶中承载着丰富的灵气，可以在周围灵气场灵气浓度降低时&a缓慢释放&r以补充。"]
	quest.72B021AA3E3944F3.title: "远古树苗"
	quest.72D47293DC94CAC0.quest_desc: ["&a量子传送装置&r可以用于跨距离&a无线传输&r物品、电力、流体、气体等物资，不消耗任何资源，且加载锚升级后可以&a跨维度&r传输。"]
	quest.73D2184B6493313C.quest_desc: ["使用&a启明工作台&r制作。"]
	quest.73E1CE96E3F14EF5.quest_desc: ["将油菜压榨为菜籽油的任务可以由笨重的&a工业挤压机&r完成，但是你也可以制作这台轻便的&a油菜压榨机&r来完成这项工作。"]
	quest.741E600F39DCCE9F.quest_desc: [
		"欢迎来到这个神秘莫测的&a星光维度&r！这里的一切都在等待着你的到来。"
		""
		"&o&a漠光石板&r&o和&a进度系统&r&o会随着你探索的深入来提供相关的索引，当然看&a任务书&r&o和&aMC百科&r&o也可以。&r"
		"{@pagebreak}"
		"&o由此开始此章分为两部分：右支为&a挑战Boss线&r&o；其余散落的各卡片为&a特殊资源&r&o收集的方式，一些获得即可知道用途或方便从JEI中查询的资源不在此列出。"
	]
	quest.741E600F39DCCE9F.title: "造访星光维度"
	quest.746F388E40C7B518.quest_desc: [
		"被诅咒的金字塔矗立于&a主世界&r广阔的大沙漠中，这是古文明的遗迹。"
		""
		"&a远古遗魂&r在此沉睡。"
		""
		"这个结构可用&a沙漠之眼&r寻找。"
	]
	quest.746F388E40C7B518.title: "被诅咒的金字塔"
	quest.747DC66590F1BF6C.quest_desc: [
		"&o&6利维坦，掌握深渊之力，甚至能撕裂时空的恐怖捕食者。&r"
		""
		"在沉沦之城中心的水底，用&a深渊祭品&r右击中心的&a深渊祭坛&r召唤利维坦。"
	]
	quest.747DC66590F1BF6C.title: "利维坦的试炼"
	quest.750732F9BA65F823.quest_desc: [
		"黄金地牢是一间由狱炎石与流光狱炎石构造的大厅。这座十分隐蔽的大厅是天境统治者的禁地。"
		""
		"黄金钥匙的保管者——残暴的天境统治者，&a烈阳巨灵&r，就位于深红色的大堂正中央。"
	]
	quest.75A85A3EB42EA77D.quest_desc: ["用瓶与塞从下界的灵气场里收集来的。"]
	quest.75CBBA83CDDDFB00.quest_desc: ["用瓶与塞从末地的灵气场里收集来的。"]
	quest.75FB247B07C3BF7B.title: "粉碎机"
	quest.7692932667CF698E.quest_desc: [
		"黑暗高塔的机关被要塞深处的数股魔力压制着，不受任何人控制。 "
		""
		"塔顶的&a暮初恶魂&r守着最后的机关；它死后会流下一滴炽热的泪。"
	]
	quest.76C12AED65BC46C7.quest_desc: [
		"星光维度中有时会发生&a流星雨&r。"
		""
		"有机会的话，就去看一场吧。流星坠落之后，会为你带来&a意料之外的收获&r。"
	]
	quest.76C12AED65BC46C7.title: "流星雨"
	quest.77C3EA4840F81D5C.quest_desc: [
		"从巨魔洞穴取来的魔豆在&a肥沃泥土&r上长成豆茎，豆茎的顶端是云上楼阁，巨人们住在云里。"
		""
		"&a巨人矿工&r握着巨人镐，披甲的&a武装巨人&r握着巨人剑，它们的身形是常人的四倍。"
	]
	quest.77CCF6E3CA3E9F38.quest_desc: ["&o真拿你没办法。&r"]
	quest.77CCF6E3CA3E9F38.title: "以防你打不过守门人或末影龙"
	quest.780012BD80D8EF84.quest_desc: [
		"&o&6你已击杀过灾变的全部boss，登临灾变之巅。&r"
		""
		"&o若是在接下来的远征中不小心把这份经历弄丢了，没关系，你随时都能回到这里。路还很长，若是累了，就停下脚步，暂且休息一下吧。&r"
	]
	quest.780012BD80D8EF84.title: "灾变之巅"
	quest.78EFDBD65E2AFE06.quest_desc: [
		"&o&6月藤巨物是星光人改造月藤花而成的邪恶产物，它拥有束缚灵魂的能力与无穷无尽的饥渴。&r"
		""
		"在与月藤巨物作战时，务必准备能够&a点燃生物&r的手段：其未被火焰点燃时，受到的所有攻击伤害都会强制降低至1点。"
	]
	quest.78F4FA00C33D561F.quest_desc: [
		"废弃堡垒是一个生成于&a末地&r外岛的建筑。"
		""
		"这里是&a末影守卫&r的迷宫堡垒。"
		""
		"这个结构可用&a虚空之眼&r寻找。"
	]
	quest.78F4FA00C33D561F.title: "废弃堡垒"
	quest.791B7C1CD2D53F4E.quest_desc: [
		"居住在星光森林中的&a星火鸟&r长着或红或蓝的羽毛，它们能制造一种独特的物质——&a星火&r。"
		""
		"向它们的巢穴中放入&a种子&r赠予它们，它们会接受你的礼物，并给予你回礼，其中便包含此种珍贵的材料。"
	]
	quest.791B7C1CD2D53F4E.title: "星火鸟的礼物"
	quest.796BB04761A96F35.title: "电弧炉"
	quest.7BF679E3CD97A80C.quest_desc: [
		"忧伤沉下去，就成了悲痛。"
		""
		"&#3EDCFF水&r让生命懂得失去——而悲痛让它懂得，失去之后还要继续&#3EDCFF流动&r。"
	]
	quest.7BF7847A3ED73423.quest_desc: [
		"&o&7你照笔记中的记叙，把几样东西倒进盆里。等它冷却下来，你手里多了一件说不上名字的东西。&r"
		""
		"&o它不像矿石，也不像一件成品，闪烁着淡黄色的微光。笔记没写它是什么，只写了下一步该做什么：&r"
		""
		"把它和钻石箱子丢在一起，并引发一场&l&a爆炸&r。然后，是粗铁块和粗铜块。"
	]
	quest.7BF7847A3ED73423.title: "未知混合物"
	quest.7C22A3F6B39F3695.quest_desc: [
		"&a野火灯笼&r会在附近大范围区域放置&a隐形光源&r，它放置的隐形光源可以被&a霜冻珍珠&r清除。"
		""
		"右击可以打开配置界面，用以设置其是否能&a穿墙&r放置隐形光源。"
	]
	quest.7C42E5E0147F4013.quest_desc: [
		"愤怒烧尽之后剩下狂怒。"
		""
		"&#FF5A01火&r让生命学会爆发——而狂怒不再是那一瞬间的火花，是持续燃烧的意志。"
	]
	quest.7C97F7759738AEA5.quest_desc: [
		"在这场远征之中，科技、魔法与冒险，从来不是孤立的三条路。"
		""
		"探索世界，收集六大维度留下的痕迹；"
		"利用魔法，将痕迹变为可加工的材料；"
		"发展科技，建立量产各类材料的产线。"
	]
	quest.7CA4F20BED9F78F7.quest_desc: [
		"流星曾划过这片夜空。天边，有东西掉下来过。"
		""
		"它不是这个世界的造物。落下的时候是热的，片刻后变得无比坚硬。外面一层烧成了黑色。"
		""
		"&l&a去找一个吧。&r"
		""
		"&o既然它不属于这里，也许有什么能替你指出它落在哪。&r"
	]
	quest.7D30D0CD5F0F151E.quest_desc: [
		"&o你不知道为什么发生了变化，但你想知道为什么。&r"
		""
		"&o跟随笔记的指引，你踏上了一场名为&l「寻找世界的本源」&r&o的远征。&r"
		""
		"&o故事，就从这里开始。&r"
	]
	quest.7D30D0CD5F0F151E.quest_subtitle: "远征"
	quest.7D30D0CD5F0F151E.title: "寻找世界的本源"
	quest.7D4F28E1F908597D.quest_desc: ["&a怪奇之钥&r掉落自&a冥行武弁&r。手持怪奇之钥右击&a封印之门&r，便可解除其上的封印，经过一段动画后，大门将会打开。"]
	quest.7D87B9FEDFC0F52F.quest_desc: ["烧炼来自于白银地牢的&a武神套装&r获得。"]
	quest.7D8BAE5F68C2DA25.quest_desc: [
		"极光宫殿矗立在极光冰川上，冰墙像极光一样泛着彩色的光。 "
		""
		"击败宫殿顶端的&a冰雪女王&r，暮色森林的夜空就会重新澄澈。"
	]
	quest.7DB027710EA5DD66.quest_desc: ["占位用"]
	quest.7DD5555C7BFD4CB4.quest_desc: ["占位用"]
	quest.7F19D8E7C6B231AF.quest_desc: ["占位用"]
	quest.7F2312EB5A2653DB.quest_desc: ["在暮色森林中，用紫水晶碎片右键活根等方块获取。"]
	quest.7F56175670CB6E0A.quest_desc: ["将紫水晶碎片丢入末地传送门中获取。"]
	quest.7F6334C85D5A5471.quest_desc: ["烧炼来自于黄金地牢的&a凤凰套装&r获得。"]
	quest.7F834AEA20EF6E4F.quest_desc: [
		"平和沉进循环里就是安定。"
		""
		"&#D8D7F0秩序&r让生命融入结构——而安定不再需要理由，也不再需要出口。"
	]
	quest.7FAF4ACD7D385BEC.quest_desc: [
		"&6&o下界的亡灵已经苏醒。&r"
		""
		"当焰魔首次被你击败后，&a炽燃狂魂&r便可在下界要塞生成。击杀它可以获得&a将熄余烬&r，可用于合成&a炽燃余烬&r，再次召唤焰魔。"
	]
